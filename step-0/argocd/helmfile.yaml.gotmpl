environments:
  default:
    values:
      - kubeContext: minikube
---
templates:
  default: &default
    kubeContext: '{{ .Values.kubeContext}}'
    namespace: argo
    values:
      - ./{{`{{ .Release.Name }}`}}/values.yaml.gotmpl
repositories:
  - name: argo
    url: https://argoproj.github.io/argo-helm
releases:
  - chart: argo/argo-cd
    name: argocd
    version: '9.0.5'
    <<: *default