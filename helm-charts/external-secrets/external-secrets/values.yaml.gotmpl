installCRDs: true
fullnameOverride: external-secrets # the Vault role is bound to ServiceAccount external-secrets
bitwarden-sdk-server:
    enabled: false
log:
    level: info
serviceMonitor:
    enabled: true
resources:
    requests:
        cpu: 25m
        memory: 96Mi
    limits:
        memory: 256Mi
webhook:
    resources:
        requests:
            cpu: 10m
            memory: 96Mi
        limits:
            memory: 192Mi
certController:
    resources:
        requests:
            cpu: 10m
            memory: 256Mi
        limits:
            memory: 512Mi
