# External Secrets: every credential reaches the cluster from Vault (ClusterSecretStore vault).
# Vault side (KV v2 mount, Kubernetes auth, policy and role external-secrets): scripts/vault.sh configure, and
# scripts/vault.sh configure-vps for the VPS k3s (environment vps, ADR 0008: same store, Vault over the tailnet).
repositories:
    - name: external-secrets
      url: https://charts.external-secrets.io
    - name: bedag
      url: https://bedag.github.io/helm-charts
environments:
    default:
        values:
            - ../environment.yaml
            - external-secrets:
                  enabled: true
                  version: 2.15.0
            - external-secrets-raw:
                  enabled: true
                  version: 2.0.2
    vps:
        values:
            - ../environment-vps.yaml
            - external-secrets:
                  enabled: true
                  version: 2.15.0
            - external-secrets-raw:
                  enabled: true
                  version: 2.0.2
---
templates:
    default: &default
        version: '{{`{{ .Values | get .Release.Name | get "version" }}`}}'
        namespace: external-secrets
        values:
            - ./{{`{{ .Release.Name }}`}}/values.yaml.gotmpl
            # values-<environment>.yaml.gotmpl overlays the shared file in every environment but default (k8s01)
            # {{ if ne .Environment.Name "default" }}
            - ./{{`{{ .Release.Name }}`}}/values-{{`{{ .Environment.Name }}`}}.yaml.gotmpl
            # {{ end }}
releases:
    - chart: external-secrets/external-secrets
      name: external-secrets
      condition: external-secrets.enabled
      <<: *default
    # ClusterSecretStore vault (+ PrometheusRule on k8s01, TokenReview permission on the VPS)
    - chart: bedag/raw
      name: external-secrets-raw
      condition: external-secrets-raw.enabled
      <<: *default
      needs:
          - external-secrets/external-secrets
