# VPS k3s: the store (Vault on k8s01 over the tailnet). Vault reviews tokens with its own reviewer ServiceAccount
# (homelab/vault-reviewer-vps), so no TokenReview permission is needed here.
# No PrometheusRule (no prometheus-operator there; the rules live on k8s01).
resources:
    {{- range $c := list "cluster-secret-store" }}
    {{- range $f := readDir (printf "./%s" $c) }}
    {{- tpl (readFile (printf "./%s" $f)) $ | nindent 4 }}
    {{- end }}
    {{- end }}
