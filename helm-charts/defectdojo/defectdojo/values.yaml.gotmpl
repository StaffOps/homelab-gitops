{{- $host := printf "defectdojo.%s" .Values.domain }}
host: {{ $host }}
siteUrl: https://{{ $host }}
# Django refuses an unknown Host: the Service name lets Prometheus scrape /django_metrics (defectdojo-raw)
alternativeHosts:
    - defectdojo-django.{{ .Release.Namespace }}.svc
imagePullPolicy: IfNotPresent # tags are pinned (chart appVersion)
# Secrets: none generated by the chart (it would draw new random values on every render and Argo CD would restart
# DefectDojo). They come from defectdojo-raw: Secret defectdojo (Vault homelab/defectdojo),
# defectdojo-valkey-specific (generated once), defectdojo-db-app (CloudNativePG).
createSecret: false
createValkeySecret: false
createPostgresqlSecret: false
admin:
    user: admin # local login (no SSO in open-source 3.x), password in Vault homelab/defectdojo (admin-password)
monitoring:
    enabled: true # django-prometheus at /django_metrics + nginx stub_status
    prometheus:
        enabled: true # nginx-prometheus-exporter sidecar (port http-metrics); ServiceMonitor in defectdojo-raw
        resources:
            requests:
                cpu: 5m
                memory: 16Mi
            limits:
                memory: 64Mi
extraConfigs:
    DD_SECURE_PROXY_SSL_HEADER: "True" # the Gateway terminates TLS and sends X-Forwarded-Proto
    DD_CSRF_TRUSTED_ORIGINS: https://{{ $host }}
celery:
    beat:
        resources:
            requests:
                cpu: 10m
                memory: 192Mi
            limits:
                cpu: null
                memory: 384Mi
    worker:
        replicas: 1
        resources:
            requests:
                cpu: 50m
                memory: 256Mi
            limits:
                cpu: null
                memory: 1Gi
        appSettings:
            poolType: solo
django:
    replicas: 1
    strategy:
        type: Recreate # media volume is ReadWriteOnce
    ingress:
        enabled: false # HTTPRoute in defectdojo-raw
        activateTLS: true # keeps the session and CSRF cookies Secure (TLS ends at the Gateway)
    nginx:
        resources:
            requests:
                cpu: 10m
                memory: 32Mi
            limits:
                cpu: null
                memory: 128Mi
    uwsgi:
        appSettings:
            processes: 2
            threads: 4
        resources:
            requests:
                cpu: 50m
                memory: 384Mi
            limits:
                cpu: null
                memory: 1Gi
    # Uploaded reports and finding attachments
    mediaPersistentVolume:
        enabled: true
        type: pvc
        persistentVolumeClaim:
            create: true
            size: 5Gi # local-path does not enforce it; the node disk is the limit
            accessModes:
                - ReadWriteOnce
            storageClassName: {{ .Values.storageClass }}
# Waits for migrations before django starts; Django needs more than the default 200Mi
dbMigrationChecker:
    resources:
        requests:
            cpu: 10m
            memory: 128Mi
        limits:
            cpu: null
            memory: 512Mi
# Migrations, admin user, fixtures. An Argo CD Sync hook: it runs on every sync (needed after an upgrade), a
# fixed name, and Argo CD deletes the previous Job first (a Job's spec is immutable).
initializer:
    run: true
    staticName: true
    keepSeconds: 86400
    jobAnnotations:
        argocd.argoproj.io/hook: Sync
        argocd.argoproj.io/hook-delete-policy: BeforeHookCreation
    resources:
        requests:
            cpu: 100m
            memory: 256Mi
        limits:
            cpu: null
            memory: 1Gi
# PostgreSQL: CloudNativePG Cluster defectdojo-db (defectdojo-raw), never the chart's own
postgresql:
    enabled: false
    auth:
        username: defectdojo
        database: defectdojo
        existingSecret: defectdojo-db-app # generated by CloudNativePG
        secretKeys:
            userPasswordKey: password
postgresServer: defectdojo-db-rw
# Valkey (Celery broker) from the chart: standalone, password from defectdojo-valkey-specific (defectdojo-raw)
valkey:
    enabled: true
    architecture: standalone
    auth:
        existingSecret: defectdojo-valkey-specific
        existingSecretPasswordKey: valkey-password
    image:
        pullPolicy: IfNotPresent
    persistence:
        enabled: true
        storageClass: {{ .Values.storageClass }}
        size: 1Gi
    resources:
        requests:
            cpu: 10m
            memory: 32Mi
        limits:
            memory: 256Mi
    metrics:
        enabled: true
        image:
            pullPolicy: IfNotPresent
        resources:
            requests:
                cpu: 5m
                memory: 16Mi
            limits:
                memory: 64Mi
        serviceMonitor:
            enabled: true
