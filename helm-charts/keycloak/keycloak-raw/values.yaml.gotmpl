{{- $gw := .Values.gateway }}
{{- $d := .Values.domain }}
resources:
    # PostgreSQL for Keycloak (CloudNativePG). The operator generates the Secret keycloak-db-app
    # (username, password) for the owner role; nothing goes to Vault.
    - apiVersion: postgresql.cnpg.io/v1
      kind: Cluster
      metadata:
          name: keycloak-db
      spec:
          instances: 1
          storage:
              storageClass: {{ .Values.storageClass }}
              size: 5Gi
          bootstrap:
              initdb:
                  database: keycloak
                  owner: keycloak
          # metrics: one PodMonitor for every cluster (cloudnative-pg-raw); the per-cluster one is deprecated
          monitoring:
              enablePodMonitor: false
          # Base backups + WAL to R2 through the Barman Cloud plugin (ObjectStore keycloak-db-r2 below)
          plugins:
              - name: barman-cloud.cloudnative-pg.io
                isWALArchiver: true
                parameters:
                    barmanObjectName: keycloak-db-r2
          # Velero backs up this namespace but not the database files (inconsistent while running)
          inheritedMetadata:
              annotations:
                  backup.velero.io/backup-volumes-excludes: pgdata
          resources:
              requests:
                  cpu: 50m
                  memory: 384Mi
              limits:
                  memory: 1Gi
    # Object store for keycloak-db (Barman Cloud plugin): s3://<bucket>/<prefix>/keycloak-db/. Credentials: the Velero R2 token
    # (Vault homelab/velero); endpoint: R2_ENDPOINT from the Argo CD render env, never in git.
    - apiVersion: external-secrets.io/v1
      kind: ExternalSecret
      metadata:
          name: keycloak-db-r2
      spec:
          refreshInterval: 1h
          secretStoreRef:
              kind: ClusterSecretStore
              name: vault
          target:
              name: keycloak-db-r2
          data:
              - secretKey: ACCESS_KEY_ID
                remoteRef:
                    key: {{ .Values.vault.prefix }}/velero
                    property: access-key-id
              - secretKey: ACCESS_SECRET_KEY
                remoteRef:
                    key: {{ .Values.vault.prefix }}/velero
                    property: secret-access-key
    - apiVersion: barmancloud.cnpg.io/v1
      kind: ObjectStore
      metadata:
          name: keycloak-db-r2
      spec:
          retentionPolicy: {{ .Values.backup.postgres.retention | quote }}
          configuration:
              destinationPath: s3://{{ .Values.backup.bucket }}/{{ .Values.backup.postgres.prefix }}/
              {{- with env "R2_ENDPOINT" }}
              endpointURL: {{ . }}
              {{- end }}
              s3Credentials:
                  accessKeyId:
                      name: keycloak-db-r2
                      key: ACCESS_KEY_ID
                  secretAccessKey:
                      name: keycloak-db-r2
                      key: ACCESS_SECRET_KEY
              wal:
                  compression: gzip
              data:
                  compression: gzip
          instanceSidecarConfiguration:
              # R2 rejects the boto3 default checksum headers (plugin docs, "Object Store Providers")
              env:
                  - name: AWS_REQUEST_CHECKSUM_CALCULATION
                    value: when_required
                  - name: AWS_RESPONSE_CHECKSUM_VALIDATION
                    value: when_required
              resources:
                  requests:
                      cpu: 10m
                      memory: 64Mi
                  limits:
                      memory: 256Mi
    - apiVersion: postgresql.cnpg.io/v1
      kind: ScheduledBackup
      metadata:
          name: keycloak-db-daily
      spec:
          schedule: {{ .Values.backup.postgres.schedule | quote }}
          backupOwnerReference: self
          immediate: true # first base backup as soon as it is created
          cluster:
              name: keycloak-db
          method: plugin
          pluginConfiguration:
              name: barman-cloud.cloudnative-pg.io
    # Bootstrap admin (Vault homelab/keycloak: admin-user, admin-password). Keycloak creates it only on the
    # first start against an empty database, as a temporary admin: create a permanent one afterwards.
    - apiVersion: external-secrets.io/v1
      kind: ExternalSecret
      metadata:
          name: keycloak-admin
      spec:
          refreshInterval: 1h
          secretStoreRef:
              kind: ClusterSecretStore
              name: vault
          target:
              name: keycloak-admin
          data:
              - secretKey: username
                remoteRef:
                    key: {{ .Values.vault.prefix }}/keycloak
                    property: admin-user
              - secretKey: password
                remoteRef:
                    key: {{ .Values.vault.prefix }}/keycloak
                    property: admin-password
    - apiVersion: gateway.networking.k8s.io/v1
      kind: HTTPRoute
      metadata:
          name: keycloak
      spec:
          parentRefs:
              - name: {{ $gw.name }}
                namespace: {{ $gw.namespace }}
                sectionName: https
          hostnames:
              - keycloak.{{ .Values.domain }}
          rules:
              - backendRefs:
                    - name: keycloak-http
                      port: 80
    # Secret of the master-realm client keycloak-config-cli used by the realm import Job
    # (Vault homelab/keycloak-automation: client-secret). Create the client once: docs/runbooks/sso.md.
    - apiVersion: external-secrets.io/v1
      kind: ExternalSecret
      metadata:
          name: keycloak-automation
      spec:
          refreshInterval: 1h
          secretStoreRef:
              kind: ClusterSecretStore
              name: vault
          target:
              name: keycloak-automation
          data:
              - secretKey: client-secret
                remoteRef:
                    key: {{ .Values.vault.prefix }}/keycloak-automation
                    property: client-secret
    # OIDC client secrets (Vault homelab/oidc: argocd, grafana, vault, ...; harbor from homelab/harbor), consumed by the realm import below
    - apiVersion: external-secrets.io/v1
      kind: ExternalSecret
      metadata:
          name: keycloak-oidc-clients
      spec:
          refreshInterval: 1h
          secretStoreRef:
              kind: ClusterSecretStore
              name: vault
          target:
              name: keycloak-oidc-clients
          dataFrom:
              - extract:
                    key: {{ .Values.vault.prefix }}/oidc
          # Harbor and Argo Workflows keep their client secret with their other secrets (Vault homelab/<app>)
          data:
              - secretKey: harbor
                remoteRef:
                    key: {{ .Values.vault.prefix }}/harbor
                    property: oidc-client-secret
              - secretKey: argo-workflows
                remoteRef:
                    key: {{ .Values.vault.prefix }}/argo-workflows
                    property: oidc-client-secret
    # Realm keycloak.realm (environment.yaml): groups /<tool>/admin and /<tool>/viewer for every tool in
    # keycloak.apps, scope "groups" (claim groups, full path), one client per app. Users are created by hand in
    # the admin console and joined to the groups of the tools they need.
    - apiVersion: v1
      kind: ConfigMap
      metadata:
          name: keycloak-realm
      data:
          realm.yaml: |
              realm: {{ .Values.keycloak.realm }}
              enabled: true
              displayName: {{ .Values.keycloak.realm }}
              loginWithEmailAllowed: true
              groups:
                  {{- range .Values.keycloak.apps }}
                  - name: {{ . }}
                    subGroups:
                        - name: admin
                        - name: viewer
                  {{- end }}
              clientScopes:
                  - name: groups
                    protocol: openid-connect
                    attributes:
                        include.in.token.scope: "true"
                        display.on.consent.screen: "false"
                    protocolMappers:
                        - name: groups
                          protocol: openid-connect
                          protocolMapper: oidc-group-membership-mapper
                          config:
                              claim.name: groups
                              full.path: "true" # /argocd/admin, /grafana/viewer, ...
                              id.token.claim: "true"
                              access.token.claim: "true"
                              userinfo.token.claim: "true"
              clients:
                  {{- range $id, $c := dict "argocd" (dict "url" (printf "https://argocd.%s" $d) "callback" "/auth/callback") "grafana" (dict "url" (printf "https://grafana.%s" $d) "callback" "/login/generic_oauth") "vault" (dict "url" (printf "https://vault.%s" $d) "callback" "/ui/vault/auth/oidc/oidc/callback") "harbor" (dict "url" (printf "https://harbor.%s" $d) "callback" "/c/oidc/callback") "argo-workflows" (dict "url" (printf "https://argo-workflows.%s" $d) "callback" "/oauth2/callback") }}
                  - clientId: {{ $id }}
                    name: {{ $id }}
                    protocol: openid-connect
                    publicClient: false
                    secret: $(env:{{ upper $id | replace "-" "_" }}_CLIENT_SECRET)
                    standardFlowEnabled: true
                    directAccessGrantsEnabled: false
                    rootUrl: {{ $c.url }}
                    redirectUris:
                        - {{ $c.url }}{{ $c.callback }}
                        {{- if eq $id "vault" }}
                        - http://localhost:8250/oidc/callback
                        {{- end }}
                    webOrigins:
                        - {{ $c.url }}
                    attributes:
                        post.logout.redirect.uris: {{ $c.url }}/*
                        pkce.code.challenge.method: S256
                    defaultClientScopes:
                        - web-origins
                        - acr
                        - basic
                        - profile
                        - email
                        - roles
                        - groups
                    {{- if eq $id "harbor" }}
                    # Harbor asks for offline_access: the refresh token keeps its CLI secret valid
                    optionalClientScopes:
                        - offline_access
                    {{- end }}
                  {{- end }}
                  # Dependency-Track: the frontend (browser) runs the login, so a public client with PKCE
                  - clientId: dependency-track
                    name: dependency-track
                    protocol: openid-connect
                    publicClient: true
                    standardFlowEnabled: true
                    directAccessGrantsEnabled: false
                    rootUrl: https://dependency-track.{{ $d }}
                    redirectUris:
                        - https://dependency-track.{{ $d }}/static/oidc-callback.html
                        - https://dependency-track.{{ $d }}/static/oidc-callback.html*
                    webOrigins:
                        - https://dependency-track.{{ $d }}
                    attributes:
                        post.logout.redirect.uris: https://dependency-track.{{ $d }}/*
                        pkce.code.challenge.method: S256
                    defaultClientScopes:
                        - web-origins
                        - acr
                        - basic
                        - profile
                        - email
                        - roles
                        - groups
                  # Services that call the MCP servers: client_credentials only (no browser login)
                  {{- range $id := list "hermes" "backstage" "keycloak-mcp" }}
                  - clientId: {{ $id }}
                    name: {{ $id }}
                    protocol: openid-connect
                    publicClient: false
                    secret: $(env:{{ upper $id | replace "-" "_" }}_CLIENT_SECRET)
                    standardFlowEnabled: false
                    directAccessGrantsEnabled: false
                    serviceAccountsEnabled: true
                    attributes:
                        # Off (deprecated in 26.8): the Admin API 401 of 26.8.2 is the audience check, fixed by the
                        # kc-admin-api scope below; tested 2026-11-15, Admin API answers 200 without a session.
                        # Kept explicit because the realm import never removes an attribute it does not list.
                        client_credentials.use_refresh_token: "false"
                    defaultClientScopes:
                        - basic
                        - profile
                        - roles
                        - groups
                        {{- if eq $id "keycloak-mcp" }}
                        # Keycloak 26.8.2+: the Admin REST API only accepts tokens carrying this scope
                        - kc-admin-api
                        {{- end }}
                  {{- end }}
              # Service-account users of those clients: read access to the MCP servers
              users:
                  {{- range $id := list "hermes" "backstage" }}
                  - username: service-account-{{ $id }}
                    enabled: true
                    serviceAccountClientId: {{ $id }}
                    groups:
                        - /mcp/viewer
                  {{- end }}
                  # Keycloak MCP server: read-only admin API access to this realm
                  - username: service-account-keycloak-mcp
                    enabled: true
                    serviceAccountClientId: keycloak-mcp
                    clientRoles:
                        realm-management:
                            - view-realm
                            - view-users
                            - view-clients
                            - view-events
                            - view-identity-providers
                            - query-users
                            - query-groups
                            - query-clients
                            - query-realms
    # Applies the realm after every sync of this app (Keycloak Healthy first). Never deletes objects it does
    # not list (managed: no-delete), so changes made in the console survive.
    - apiVersion: batch/v1
      kind: Job
      metadata:
          name: keycloak-realm-import
          annotations:
              argocd.argoproj.io/hook: PostSync
              argocd.argoproj.io/hook-delete-policy: BeforeHookCreation
      spec:
          backoffLimit: 6
          ttlSecondsAfterFinished: 86400
          template:
              spec:
                  restartPolicy: OnFailure
                  securityContext:
                      runAsNonRoot: true
                      runAsUser: 1000
                      seccompProfile:
                          type: RuntimeDefault
                  containers:
                      - name: keycloak-config-cli
                        image: docker.io/adorsys/keycloak-config-cli:6.5.1-26
                        securityContext:
                            allowPrivilegeEscalation: false
                            capabilities:
                                drop: [ALL]
                        env:
                            - name: KEYCLOAK_URL
                              value: http://keycloak-http.keycloak.svc
                            - name: KEYCLOAK_AVAILABILITYCHECK_ENABLED
                              value: "true"
                            - name: KEYCLOAK_AVAILABILITYCHECK_TIMEOUT
                              value: 300s
                            # Logs in as the master-realm service client keycloak-config-cli (role admin), not
                            # as a person: Vault homelab/keycloak-automation (client-secret)
                            - name: KEYCLOAK_GRANTTYPE
                              value: client_credentials
                            - name: KEYCLOAK_CLIENTID
                              value: keycloak-config-cli
                            - name: KEYCLOAK_CLIENTSECRET
                              valueFrom:
                                  secretKeyRef:
                                      name: keycloak-automation
                                      key: client-secret
                            - name: IMPORT_FILES_LOCATIONS
                              value: /config/*
                            - name: IMPORT_VARSUBSTITUTION_ENABLED
                              value: "true"
                            - name: IMPORT_MANAGED_GROUP
                              value: no-delete
                            - name: IMPORT_MANAGED_USER
                              value: no-delete # only the service-account users listed in the realm
                            - name: IMPORT_MANAGED_CLIENT
                              value: no-delete
                            - name: IMPORT_MANAGED_CLIENT_SCOPE
                              value: no-delete
                            - name: IMPORT_MANAGED_REQUIRED_ACTION
                              value: no-delete
                            - name: IMPORT_MANAGED_ROLE
                              value: no-delete
                            {{- range $id := list "argocd" "grafana" "vault" "hermes" "backstage" "keycloak-mcp" "harbor" "argo-workflows" }}
                            - name: {{ upper $id | replace "-" "_" }}_CLIENT_SECRET
                              valueFrom:
                                  secretKeyRef:
                                      name: keycloak-oidc-clients
                                      key: {{ $id }}
                            {{- end }}
                        volumeMounts:
                            - name: realm
                              mountPath: /config
                        resources:
                            requests:
                                cpu: 50m
                                memory: 256Mi
                            limits:
                                memory: 512Mi
                  volumes:
                      - name: realm
                        configMap:
                            name: keycloak-realm
    # PrometheusRule: rules inserted as-is (no tpl), so they keep plain Prometheus templates
    - apiVersion: monitoring.coreos.com/v1
      kind: PrometheusRule
      metadata:
          name: keycloak
      spec:
          {{- readFile "./prometheus.rules.yaml" | nindent 10 }}
