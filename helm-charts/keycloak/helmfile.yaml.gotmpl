# Keycloak (identity provider) on the official image (chart codecentric/keycloakx), PostgreSQL from
# CloudNativePG (Cluster keycloak-db in keycloak-raw). Bootstrap admin from Vault homelab/keycloak.
repositories:
    - name: codecentric
      url: https://codecentric.github.io/helm-charts
    - name: bedag
      url: https://bedag.github.io/helm-charts
environments:
    default:
        values:
            - ../environment.yaml
            - keycloak:
                  enabled: true
                  version: 7.4.0 # Keycloak 26.8.x
            - keycloak-raw:
                  enabled: true
                  version: 2.0.2
---
templates:
    default: &default
        version: '{{`{{ .Values | get .Release.Name | get "version" }}`}}'
        namespace: keycloak
        values:
            - ./{{`{{ .Release.Name }}`}}/values.yaml.gotmpl
releases:
    # PostgreSQL Cluster, admin ExternalSecret, HTTPRoute
    - chart: bedag/raw
      name: keycloak-raw
      condition: keycloak-raw.enabled
      <<: *default
    - chart: codecentric/keycloakx
      name: keycloak
      condition: keycloak.enabled
      <<: *default
