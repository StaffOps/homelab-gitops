# Argo Events: event-driven automation. EventSources receive or poll events, the EventBus (NATS JetStream, one
# node) carries them, Sensors act on them (submit an Argo Workflow, call HTTP, log). Today: Argo CD notifications
# (sync succeeded/failed, health degraded) arrive at EventSource argocd. GitHub cannot reach the lab, so repositories
# are watched by polling with Argo Workflows (ClusterWorkflowTemplate github-watch) or a calendar EventSource
# (image-scan), not by webhooks.
repositories:
    - name: argo
      url: https://argoproj.github.io/argo-helm
    - name: bedag
      url: https://bedag.github.io/helm-charts
    # private charts (StaffOps/private-helm-charts); credentials from the Argo CD render env (argocd-render-env)
    - name: staffops-private
      url: ghcr.io/staffops/charts
      oci: true
      username: '{{ env "GHCR_CHARTS_USERNAME" }}'
      password: '{{ env "GHCR_CHARTS_TOKEN" }}'
environments:
    default:
        values:
            - ../environment.yaml
            - argo-events:
                  enabled: true
                  version: 2.4.28 # Argo Events v1.9.11
            - argo-events-raw:
                  enabled: true
                  version: 2.0.2
            # Trivy → Dependency-Track for the images of the GitHub orgs (image-scan/catalog.yaml)
            - image-scan:
                  enabled: true
                  version: 0.2.0
---
templates:
    default: &default
        version: '{{`{{ .Values | get .Release.Name | get "version" }}`}}'
        namespace: argo-events
        values:
            - ./{{`{{ .Release.Name }}`}}/values.yaml.gotmpl
releases:
    - chart: argo/argo-events
      name: argo-events
      condition: argo-events.enabled
      <<: *default
    # EventBus, EventSources, Sensors (need the chart's CRDs)
    - chart: bedag/raw
      name: argo-events-raw
      condition: argo-events-raw.enabled
      needs:
          - argo-events
      <<: *default
    # Hourly poll of the org images (calendar EventSource → Sensor → Workflow in argo-workflows)
    - chart: staffops-private/event
      name: image-scan
      condition: image-scan.enabled
      needs:
          - argo-events-raw
      <<: *default
