# Backstage: the developer portal (StaffOps/backstage-platform) at https://backstage.<domain>, login with Keycloak
# (client backstage, groups /backstage/admin and /backstage/viewer). Release backstage = the workload (staffops/generic:
# Deployment, Service, HTTPRoute on the shared Gateway, ExternalSecret of the credentials mounted at /run/secrets; the
# app-config files are baked into the image); backstage-raw = PostgreSQL (CloudNativePG Cluster backstage-db, backed up to R2), the ghcr pull
# Secret. Backups: daily base backups + continuous WAL to R2, point-in-time recovery (ADR 0001 of backstage-platform,
# amended: no PreSync backup hook).
# Image: ghcr.io/staffops/backstage-platform, semver tag + digest in backstage/values.yaml.gotmpl; Renovate opens the
# bump PR (renovate.json5 at the repo root), merging it deploys.
repositories:
    - name: staffops
      url: https://staffops.github.io/helm-charts
    - name: bedag
      url: https://bedag.github.io/helm-charts
environments:
    default:
        values:
            - ../environment.yaml
            - backstage:
                  enabled: true
                  version: 0.1.0 # staffops/generic
                  # PENDING owner decision: TechDocs from R2 bucket staffops-techdocs (external builder in CI, read-only
                  # token in Vault homelab/backstage). Off = TECHDOCS_S3_* unset: TechDocs pages fail, the rest works.
                  techdocsR2: false
            - backstage-raw:
                  enabled: true
                  version: 2.0.2
---
templates:
    default: &default
        version: '{{`{{ .Values | get .Release.Name | get "version" }}`}}'
        namespace: backstage
        values:
            - ./{{`{{ .Release.Name }}`}}/values.yaml.gotmpl
releases:
    # PostgreSQL Cluster + backups, ghcr pull Secret
    - chart: bedag/raw
      name: backstage-raw
      condition: backstage-raw.enabled
      <<: *default
    - chart: staffops/generic
      name: backstage
      condition: backstage.enabled
      <<: *default
