# One file per object in resources/, rendered with the helmfile values.
resources:
    {{- range $f := readDir "./resources" }}
    {{- tpl (readFile (printf "./%s" $f)) $ | nindent 4 }}
    {{- end }}
    # PrometheusRule: rules inserted as-is (no tpl), so they keep plain Prometheus templates
    - apiVersion: monitoring.coreos.com/v1
      kind: PrometheusRule
      metadata:
          name: cert-manager
      spec:
          {{- readFile "./prometheus.rules.yaml" | nindent 10 }}
