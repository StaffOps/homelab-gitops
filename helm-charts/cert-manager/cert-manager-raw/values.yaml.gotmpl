# One directory per component, one file per object. This list picks the components of the environment;
# values-<environment>.yaml.gotmpl replaces it (lists are not merged).
resources:
    {{- range $c := list "cloudflare" "issuers" "prometheus-rule" }}
    {{- range $f := readDir (printf "./%s" $c) }}
    {{- tpl (readFile (printf "./%s" $f)) $ | nindent 4 }}
    {{- end }}
    {{- end }}
