crds:
    enabled: true
    keep: true
enableCertificateOwnerRef: true
global:
    logLevel: 2
extraArgs:
    - --logging-format=json
    # Check the DNS-01 TXT record on public resolvers, not on the LAN resolver (split DNS)
    - --dns01-recursive-nameservers-only
    - --dns01-recursive-nameservers=1.1.1.1:53,8.8.8.8:53
resources:
    requests:
        cpu: 10m
        memory: 128Mi
    limits:
        memory: 256Mi
prometheus:
    enabled: true
    servicemonitor:
        enabled: true
webhook:
    # 2 replicas (not HA: one node): a crash, restart or rollout of one Pod does not stop it. No PDB (single node). The webhook fails closed.
    replicaCount: 2
    resources:
        requests:
            cpu: 10m
            memory: 96Mi
        limits:
            memory: 192Mi
cainjector:
    resources:
        requests:
            cpu: 10m
            memory: 192Mi
        limits:
            memory: 384Mi
