# VPS k3s: no prometheus-operator, so no ServiceMonitor (Alloy scrapes the metrics Service instead).
prometheus:
    servicemonitor:
        enabled: false
# Memory-bound host (7.8 GB shared with docker compose until the cutover): one webhook replica, an exception to the
# two-replica rule for fail-closed webhooks (AGENTS.md). Requests below k8s01's 7-day peaks, limits above them.
resources:
    requests:
        cpu: 5m
        memory: 48Mi
    limits:
        memory: 160Mi
webhook:
    replicaCount: 1
    resources:
        requests:
            cpu: 5m
            memory: 32Mi
        limits:
            memory: 128Mi
cainjector:
    resources:
        requests:
            cpu: 5m
            memory: 64Mi
        limits:
            memory: 224Mi
