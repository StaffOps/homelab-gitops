# VPS k3s: no prometheus-operator, so no ServiceMonitor (Alloy scrapes the metrics Service instead).
serviceMonitor:
    enabled: false
# Memory-bound host: only Ingresses to watch there. Request below k8s01's 7-day peak, limit above it.
resources:
    requests:
        cpu: 5m
        memory: 48Mi
    limits:
        memory: 160Mi
# Only Ingresses annotated external-dns.alpha.kubernetes.io/hostname: the names that already exist keep their manual
# CNAMEs to the VPS (no owner TXT, upsert-only could not take them over); new names (*-vps) carry the annotation.
annotationFilter: external-dns.alpha.kubernetes.io/hostname
