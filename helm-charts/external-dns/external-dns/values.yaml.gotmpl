provider:
    name: cloudflare
env:
    - name: CF_API_TOKEN
      valueFrom:
          secretKeyRef:
              name: cloudflare-api-token
              key: api-token
# sources, policy, owner id and prefix are per cluster (externalDns in the environment file): each cluster owns
# only the records carrying its owner TXT, so two external-dns share the zone without fighting
sources:
    {{- toYaml .Values.externalDns.sources | nindent 4 }}
domainFilters:
    - {{ .Values.domain }}
policy: {{ .Values.externalDns.policy }}
registry: txt
txtOwnerId: {{ .Values.externalDns.txtOwnerId }}
txtPrefix: {{ .Values.externalDns.txtPrefix }}
interval: 1m
logFormat: json
logLevel: info
# --cloudflare-proxied stays off (default): LAN addresses must not go through the Cloudflare proxy
extraArgs:
    - --cloudflare-dns-records-per-page=5000
serviceMonitor:
    enabled: true
resources:
    requests:
        cpu: 10m
        memory: 64Mi
    limits:
        memory: 320Mi
