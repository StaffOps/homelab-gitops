# external-dns: publishes the hostnames of Gateway API HTTPRoutes on Cloudflare (token from Vault
# homelab/cloudflare). Records point at the Gateway LAN IP and are never proxied by Cloudflare.
repositories:
    - name: external-dns
      url: https://kubernetes-sigs.github.io/external-dns
    - name: bedag
      url: https://bedag.github.io/helm-charts
environments:
    default:
        values:
            - ../environment.yaml
            - external-dns:
                  enabled: true
                  version: 1.23.0
            - external-dns-raw:
                  enabled: true
                  version: 2.0.2
---
templates:
    default: &default
        version: '{{`{{ .Values | get .Release.Name | get "version" }}`}}'
        namespace: external-dns
        values:
            - ./{{`{{ .Release.Name }}`}}/values.yaml.gotmpl
releases:
    # Cloudflare token (ExternalSecret)
    - chart: bedag/raw
      name: external-dns-raw
      condition: external-dns-raw.enabled
      <<: *default
    - chart: external-dns/external-dns
      name: external-dns
      condition: external-dns.enabled
      <<: *default
