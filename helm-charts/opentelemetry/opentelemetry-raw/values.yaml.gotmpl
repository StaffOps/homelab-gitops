# One directory per component (collector CR + RBAC, one file per object or group), rendered with the helmfile
# values. OTTL and collector ${env:…} references pass through untouched; bedag/raw does not run tpl again.
# This list picks the components of the environment; values-<environment>.yaml.gotmpl replaces it.
# (Rendered in environment default only: the gateway and logs collectors read k8s01 values.)
resources:
    {{- if eq .Environment.Name "default" }}
    {{- range $c := list "agent" "gateway" "logs" "prometheus-rule" }}
    {{- range $f := readDir (printf "./%s" $c) }}
    {{- tpl (readFile (printf "./%s" $f)) $ | nindent 4 }}
    {{- end }}
    {{- end }}
    {{- end }}
