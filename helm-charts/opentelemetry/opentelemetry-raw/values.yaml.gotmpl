# One file per collector in resources/ (CR + RBAC), rendered with the helmfile values. OTTL and collector
# ${env:…} references pass through untouched; bedag/raw does not run tpl again.
resources:
    {{- range $f := readDir "./resources" }}
    {{- tpl (readFile (printf "./%s" $f)) $ | nindent 4 }}
    {{- end }}
    # PrometheusRule: rules inserted as-is (no tpl), so they keep plain Prometheus templates
    - apiVersion: monitoring.coreos.com/v1
      kind: PrometheusRule
      metadata:
          name: otel-collector
      spec:
          {{- readFile "./prometheus.rules.yaml" | nindent 10 }}
