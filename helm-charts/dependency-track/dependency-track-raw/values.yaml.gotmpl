{{- $pg := .Values.backup.postgres }}
resources:
    # PostgreSQL (CloudNativePG); the operator generates Secret dtrack-db-app (username, password)
    - apiVersion: postgresql.cnpg.io/v1
      kind: Cluster
      metadata:
          name: dtrack-db
      spec:
          instances: 1
          storage:
              storageClass: {{ .Values.storageClass }}
              size: 10Gi
          bootstrap:
              {{- if ($pg | get "restore" false) }}
              # Disaster recovery (backup.postgres.restore in environment.yaml): rebuild from the R2 backups
              recovery:
                  source: origin
                  {{- with ($pg | get "restoreTargetTime" "") }}
                  recoveryTarget:
                      targetTime: {{ . | quote }}
                  {{- end }}
              {{- else }}
              initdb:
                  database: dtrack
                  owner: dtrack
              {{- end }}
          {{- if ($pg | get "restore" false) }}
          externalClusters:
              - name: origin
                plugin:
                    name: barman-cloud.cloudnative-pg.io
                    parameters:
                        barmanObjectName: dtrack-db-r2
                        serverName: dtrack-db{{ ($pg | get "restoreFromSuffix" "") }}
          {{- end }}
          # metrics: one PodMonitor for every cluster (cloudnative-pg-raw); the per-cluster one is deprecated
          monitoring:
              enablePodMonitor: false
          # Base backups + WAL to R2 through the Barman Cloud plugin (ObjectStore dtrack-db-r2 below)
          plugins:
              - name: barman-cloud.cloudnative-pg.io
                isWALArchiver: true
                parameters:
                    barmanObjectName: dtrack-db-r2
                    {{- with ($pg | get "serverSuffix" "") }}
                    serverName: dtrack-db{{ . }}
                    {{- end }}
          # Velero backs up this namespace but not the database files (inconsistent while running)
          inheritedMetadata:
              annotations:
                  backup.velero.io/backup-volumes-excludes: pgdata
          resources:
              requests:
                  cpu: 50m
                  memory: 1Gi
              limits:
                  memory: 2Gi
    # Object store for dtrack-db (Barman Cloud plugin): s3://<bucket>/<prefix>/dtrack-db/. Credentials: the Velero R2 token
    # (Vault homelab/velero); endpoint: R2_ENDPOINT from the Argo CD render env, never in git.
    - apiVersion: external-secrets.io/v1
      kind: ExternalSecret
      metadata:
          name: dtrack-db-r2
      spec:
          refreshInterval: 1h
          secretStoreRef:
              kind: ClusterSecretStore
              name: vault
          target:
              name: dtrack-db-r2
          data:
              - secretKey: ACCESS_KEY_ID
                remoteRef:
                    key: {{ .Values.vault.prefix }}/velero
                    property: access-key-id
              - secretKey: ACCESS_SECRET_KEY
                remoteRef:
                    key: {{ .Values.vault.prefix }}/velero
                    property: secret-access-key
    - apiVersion: barmancloud.cnpg.io/v1
      kind: ObjectStore
      metadata:
          name: dtrack-db-r2
      spec:
          retentionPolicy: {{ .Values.backup.postgres.retention | quote }}
          configuration:
              destinationPath: s3://{{ .Values.backup.bucket }}/{{ .Values.backup.postgres.prefix }}/
              {{- with env "R2_ENDPOINT" }}
              endpointURL: {{ . }}
              {{- end }}
              s3Credentials:
                  accessKeyId:
                      name: dtrack-db-r2
                      key: ACCESS_KEY_ID
                  secretAccessKey:
                      name: dtrack-db-r2
                      key: ACCESS_SECRET_KEY
              wal:
                  compression: gzip
              data:
                  compression: gzip
          instanceSidecarConfiguration:
              # R2 rejects the boto3 default checksum headers (plugin docs, "Object Store Providers")
              env:
                  - name: AWS_REQUEST_CHECKSUM_CALCULATION
                    value: when_required
                  - name: AWS_RESPONSE_CHECKSUM_VALIDATION
                    value: when_required
              resources:
                  requests:
                      cpu: 10m
                      memory: 64Mi
                  limits:
                      memory: 256Mi
    - apiVersion: postgresql.cnpg.io/v1
      kind: ScheduledBackup
      metadata:
          name: dtrack-db-daily
      spec:
          schedule: {{ .Values.backup.postgres.schedule | quote }}
          backupOwnerReference: self
          immediate: true # first base backup as soon as it is created
          cluster:
              name: dtrack-db
          method: plugin
          pluginConfiguration:
              name: barman-cloud.cloudnative-pg.io
    # KEK that encrypts the secrets Dependency-Track stores in its database (Vault homelab/dependency-track: kek,
    # a base64 32-byte key: openssl rand -base64 32). Losing it makes those stored secrets unreadable.
    - apiVersion: external-secrets.io/v1
      kind: ExternalSecret
      metadata:
          name: dependency-track-kek
      spec:
          refreshInterval: 1h
          secretStoreRef:
              kind: ClusterSecretStore
              name: vault
          target:
              name: dependency-track-kek
          data:
              - secretKey: kek
                remoteRef:
                    key: {{ .Values.vault.prefix }}/dependency-track
                    property: kek
    # Trivy server: the Trivy vulnerability analyzer of Dependency-Track (Administration → Analyzers → Trivy, runtime
    # config in the DT database) sends components here and gets findings back from the Trivy DB (Alpine secdb, GHSA,
    # distro feeds), the same results as the golden-images scan (same version, 0.76.1). URL
    # http://trivy.dependency-track:4954, token from Vault homelab/trivy-server (also stored as DT secret trivy-token).
    - apiVersion: external-secrets.io/v1
      kind: ExternalSecret
      metadata:
          name: trivy-server
      spec:
          refreshInterval: 1h
          secretStoreRef:
              kind: ClusterSecretStore
              name: vault
          target:
              name: trivy-server
          data:
              - secretKey: TRIVY_TOKEN
                remoteRef:
                    key: {{ .Values.vault.prefix }}/trivy-server
                    property: token
    # Trivy DB (~1 GiB unpacked, refreshed by the server every 12 h) and Java DB
    - apiVersion: v1
      kind: PersistentVolumeClaim
      metadata:
          name: trivy-cache
      spec:
          accessModes: [ReadWriteOnce]
          storageClassName: {{ .Values.storageClass }}
          resources:
              requests:
                  storage: 5Gi
    - apiVersion: apps/v1
      kind: Deployment
      metadata:
          name: trivy
          labels:
              app.kubernetes.io/name: trivy
      spec:
          replicas: 1
          strategy:
              type: Recreate # RWO cache volume
          selector:
              matchLabels:
                  app.kubernetes.io/name: trivy
          template:
              metadata:
                  labels:
                      app.kubernetes.io/name: trivy
              spec:
                  automountServiceAccountToken: false
                  securityContext:
                      runAsNonRoot: true
                      runAsUser: 65532
                      runAsGroup: 65532
                      fsGroup: 65532
                      seccompProfile:
                          type: RuntimeDefault
                  containers:
                      - name: trivy
                        image: docker.io/aquasec/trivy:0.76.1@sha256:790fd66d1697395d8693d1acaa1ea702406a20f109b6fc7bac8db623eca6c06c
                        args: [server, --listen, "0.0.0.0:4954"]
                        env:
                            - name: TRIVY_CACHE_DIR
                              value: /cache
                            - name: HOME
                              value: /tmp
                            - name: TRIVY_NO_PROGRESS
                              value: "true"
                        envFrom:
                            - secretRef:
                                  name: trivy-server # TRIVY_TOKEN: clients must send it (header Trivy-Token)
                        ports:
                            - name: http
                              containerPort: 4954
                        readinessProbe:
                            httpGet:
                                path: /healthz
                                port: http
                            periodSeconds: 10
                        livenessProbe:
                            httpGet:
                                path: /healthz
                                port: http
                            initialDelaySeconds: 300 # first start downloads the DB
                            periodSeconds: 30
                        securityContext:
                            allowPrivilegeEscalation: false
                            readOnlyRootFilesystem: true
                            capabilities:
                                drop: [ALL]
                        resources:
                            requests:
                                cpu: 20m
                                memory: 512Mi
                            limits:
                                memory: 2Gi
                        volumeMounts:
                            - name: cache
                              mountPath: /cache
                            - name: tmp
                              mountPath: /tmp
                  volumes:
                      - name: cache
                        persistentVolumeClaim:
                            claimName: trivy-cache
                      - name: tmp
                        emptyDir:
                            sizeLimit: 1Gi
    - apiVersion: v1
      kind: Service
      metadata:
          name: trivy
          labels:
              app.kubernetes.io/name: trivy
      spec:
          selector:
              app.kubernetes.io/name: trivy
          ports:
              - name: http
                port: 4954
                targetPort: http
                appProtocol: http
