# Dependency-Track (SBOM analysis) on PostgreSQL from CloudNativePG (Cluster dtrack-db in dependency-track-raw).
# The secret-encryption key (KEK) comes from Vault homelab/dependency-track.
repositories:
    - name: dependency-track
      url: https://dependencytrack.github.io/helm-charts
    - name: bedag
      url: https://bedag.github.io/helm-charts
environments:
    default:
        values:
            - ../environment.yaml
            - dependency-track:
                  enabled: true
                  version: 2.9.0 # Dependency-Track 5.2.x
            - dependency-track-raw:
                  enabled: true
                  version: 2.0.2
---
templates:
    default: &default
        version: '{{`{{ .Values | get .Release.Name | get "version" }}`}}'
        namespace: dependency-track
        values:
            - ./{{`{{ .Release.Name }}`}}/values.yaml.gotmpl
releases:
    # PostgreSQL Cluster and the KEK ExternalSecret
    - chart: bedag/raw
      name: dependency-track-raw
      condition: dependency-track-raw.enabled
      <<: *default
    - chart: dependency-track/dependency-track
      name: dependency-track
      condition: dependency-track.enabled
      <<: *default
