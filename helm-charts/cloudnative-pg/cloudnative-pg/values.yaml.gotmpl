fullnameOverride: cnpg
# 2 replicas (not HA: one node): a crash, restart or rollout of one Pod does not stop it. No PDB (single node). Operator with leader election; its webhook fails closed.
replicaCount: 2
crds:
    create: true
monitoring:
    podMonitorEnabled: true
    # The official dashboard is vendored (newer upstream revision, operator Pod regex fixed for fullnameOverride cnpg)
    # in helm-charts/monitoring/monitoring-raw/dashboards/data/cnpg.json → Grafana folder "Databases".
    grafanaDashboard:
        create: false
resources:
    requests:
        cpu: 50m
        memory: 128Mi
    limits:
        memory: 512Mi
