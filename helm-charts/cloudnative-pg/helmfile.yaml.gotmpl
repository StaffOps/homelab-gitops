# CloudNativePG operator: PostgreSQL clusters as `Cluster` resources (postgresql.cnpg.io/v1). Apps that need a
# database declare their own Cluster in their <app>-raw release (e.g. keycloak). The PostgreSQL image is the
# operator's default for this version (pinned by the operator release).
repositories:
    - name: cnpg
      url: https://cloudnative-pg.github.io/charts
    - name: bedag
      url: https://bedag.github.io/helm-charts
environments:
    default:
        values:
            - ../environment.yaml
            - cloudnative-pg:
                  enabled: true
                  version: 0.29.1 # operator 1.30.1
            - cloudnative-pg-raw:
                  enabled: true
                  version: 2.0.2
            - plugin-barman-cloud:
                  enabled: true
                  version: 0.9.0 # plugin v0.16.0
---
releases:
    - chart: cnpg/cloudnative-pg
      name: cloudnative-pg
      namespace: cnpg-system
      condition: cloudnative-pg.enabled
      version: '{{ .Values | get "cloudnative-pg" | get "version" }}'
      values:
          - ./cloudnative-pg/values.yaml.gotmpl
    # Barman Cloud plugin (CNPG-I): backups and WAL archiving to object storage (R2). CloudNativePG 1.30 no longer
    # ships the in-tree barmanObjectStore. Needs cert-manager (the chart creates its own Issuer and certificates).
    - chart: cnpg/plugin-barman-cloud
      name: plugin-barman-cloud
      namespace: cnpg-system
      condition: plugin-barman-cloud.enabled
      version: '{{ .Values | get "plugin-barman-cloud" | get "version" }}'
      needs:
          - cloudnative-pg
      values:
          - ./plugin-barman-cloud/values.yaml.gotmpl
    # PrometheusRule for every CloudNativePG cluster of the lab (the operator chart ships none)
    - chart: bedag/raw
      name: cloudnative-pg-raw
      namespace: cnpg-system
      condition: cloudnative-pg-raw.enabled
      version: '{{ .Values | get "cloudnative-pg-raw" | get "version" }}'
      values:
          - ./cloudnative-pg-raw/values.yaml.gotmpl
