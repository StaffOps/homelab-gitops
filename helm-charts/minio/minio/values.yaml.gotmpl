mode: standalone
existingSecret: minio-root # ExternalSecret in minio-raw (keys rootUser, rootPassword)
replicas: 1
persistence:
    enabled: true
    storageClass: {{ .Values.storageClass }}
    accessMode: ReadWriteOnce
    size: 50Gi
resources:
    requests:
        cpu: 50m
        memory: 256Mi
    limits:
        memory: 1Gi
# Exposure is through Gateway API HTTPRoutes (minio-raw)
ingress:
    enabled: false
consoleIngress:
    enabled: false
users: []
buckets: []
policies: []
oidc:
    enabled: false
metrics:
    serviceMonitor:
        enabled: true
        includeNode: true
        public: true
