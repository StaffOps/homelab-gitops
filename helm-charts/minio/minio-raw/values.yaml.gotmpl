{{- $gw := .Values.gateway }}
resources:
    # Root credentials (Vault homelab/minio: root-user, root-password)
    - apiVersion: external-secrets.io/v1
      kind: ExternalSecret
      metadata:
          name: minio-root
      spec:
          refreshInterval: 1h
          secretStoreRef:
              kind: ClusterSecretStore
              name: vault
          target:
              name: minio-root
          data:
              - secretKey: rootUser
                remoteRef:
                    key: {{ .Values.vault.prefix }}/minio
                    property: root-user
              - secretKey: rootPassword
                remoteRef:
                    key: {{ .Values.vault.prefix }}/minio
                    property: root-password
    {{- range $host, $svc := dict "minio" (list "minio" 9000) "console-minio" (list "minio-console" 9001) }}
    - apiVersion: gateway.networking.k8s.io/v1
      kind: HTTPRoute
      metadata:
          name: {{ $host }}
      spec:
          parentRefs:
              - name: {{ $gw.name }}
                namespace: {{ $gw.namespace }}
                sectionName: https
          hostnames:
              - {{ $host }}.{{ $.Values.domain }}
          rules:
              - backendRefs:
                    - name: {{ index $svc 0 }}
                      port: {{ index $svc 1 }}
    {{- end }}
