# MinIO (standalone) as the lab's S3 endpoint. Root credentials from Vault homelab/minio.
# Note: the upstream chart is in maintenance mode (last image 2024-12); revisit before relying on it.
repositories:
    - name: minio
      url: https://charts.min.io/
    - name: bedag
      url: https://bedag.github.io/helm-charts
environments:
    default:
        values:
            - ../environment.yaml
            - minio:
                  enabled: true
                  version: 5.4.0
            - minio-raw:
                  enabled: true
                  version: 2.0.2
---
templates:
    default: &default
        version: '{{`{{ .Values | get .Release.Name | get "version" }}`}}'
        namespace: minio
        values:
            - ./{{`{{ .Release.Name }}`}}/values.yaml.gotmpl
releases:
    # Root credentials (ExternalSecret) and HTTPRoutes for the API and the console
    - chart: bedag/raw
      name: minio-raw
      condition: minio-raw.enabled
      <<: *default
    - chart: minio/minio
      name: minio
      condition: minio.enabled
      <<: *default
