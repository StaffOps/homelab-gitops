fullnameOverride: kyverno
# Admission covers every namespace, kube-system and kyverno included, so the zone label (kyverno-raw
# pod-zone-label) reaches all Pods. Safe only while every policy that matches Pods uses failurePolicy Ignore:
# with Kyverno down, a Fail policy would block Pods in kube-system and Kyverno's own Pods.
config:
    excludeKyvernoNamespace: false
    resourceFiltersExcludeNamespaces:
        - kube-system
        - kyverno
    webhooks:
        namespaceSelector:
            matchExpressions: [] # replaces the chart default (NotIn kube-system)
# Single node: one replica per controller
admissionController:
    replicas: 1
    container:
        resources:
            requests:
                cpu: 20m
                memory: 256Mi
            limits:
                memory: 512Mi
    serviceMonitor:
        enabled: true
backgroundController:
    replicas: 1
    resources:
        requests:
            cpu: 10m
            memory: 160Mi
        limits:
            memory: 320Mi
    serviceMonitor:
        enabled: true
cleanupController:
    replicas: 1
    resources:
        requests:
            cpu: 10m
            memory: 160Mi
        limits:
            memory: 320Mi
    serviceMonitor:
        enabled: true
reportsController:
    replicas: 1
    resources:
        requests:
            cpu: 200m
            memory: 160Mi
        limits:
            memory: 320Mi
    serviceMonitor:
        enabled: true
grafana:
    enabled: true
    namespace: monitoring
