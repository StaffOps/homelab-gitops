resources:
    # Label topology.kubernetes.io/zone=<zone> (environment.yaml) on every new Pod, so telemetry and
    # topology-aware tooling see one zone for the lab. Only Pods are mutated, at CREATE:
    #   - autogen is off, so Deployments/StatefulSets/... in git are never touched and Argo CD sees no drift
    #     (Pods belong to ReplicaSets, Argo CD does not diff them);
    #   - running Pods get the label when they are recreated (rollout restart);
    #   - kube-system and kyverno are no longer excluded (kyverno chart values: config), so every namespace is covered.
    # failurePolicy Ignore: Pods are still admitted while Kyverno is down; the sweeper CronJob below labels them.
    - apiVersion: policies.kyverno.io/v1
      kind: MutatingPolicy
      metadata:
          name: pod-zone-label
      spec:
          failurePolicy: Ignore
          autogen:
              podControllers:
                  controllers: []
          matchConstraints:
              resourceRules:
                  - apiGroups: [""]
                    apiVersions: [v1]
                    operations: [CREATE]
                    resources: [pods]
          mutations:
              - patchType: ApplyConfiguration
                applyConfiguration:
                    expression: >-
                        Object{metadata: Object.metadata{labels: {"topology.kubernetes.io/zone": "{{ .Values.zone }}"}}}
    # Pods that admission cannot label: static/mirror Pods (created by the kubelet, group system:nodes) and Pods
    # created while Kyverno is down (failurePolicy Ignore). Every 5 minutes, label (or correct) every Pod whose zone
    # differs; no match is a no-op.
    - apiVersion: v1
      kind: ServiceAccount
      metadata:
          name: pod-zone-label-sweeper
          namespace: kyverno
    - apiVersion: rbac.authorization.k8s.io/v1
      kind: ClusterRole
      metadata:
          name: pod-zone-label-sweeper
      rules:
          - apiGroups: [""]
            resources: [pods]
            verbs: [get, list, patch]
    - apiVersion: rbac.authorization.k8s.io/v1
      kind: ClusterRoleBinding
      metadata:
          name: pod-zone-label-sweeper
      roleRef:
          apiGroup: rbac.authorization.k8s.io
          kind: ClusterRole
          name: pod-zone-label-sweeper
      subjects:
          - kind: ServiceAccount
            name: pod-zone-label-sweeper
            namespace: kyverno
    - apiVersion: batch/v1
      kind: CronJob
      metadata:
          name: pod-zone-label-sweeper
          namespace: kyverno
      spec:
          schedule: "*/5 * * * *"
          concurrencyPolicy: Forbid
          successfulJobsHistoryLimit: 1
          failedJobsHistoryLimit: 3
          jobTemplate:
              spec:
                  backoffLimit: 2
                  activeDeadlineSeconds: 120
                  ttlSecondsAfterFinished: 3600
                  template:
                      spec:
                          serviceAccountName: pod-zone-label-sweeper
                          restartPolicy: Never
                          securityContext:
                              runAsNonRoot: true
                              runAsUser: 65534
                              seccompProfile:
                                  type: RuntimeDefault
                          containers:
                              - name: kubectl
                                image: registry.k8s.io/kubectl:v1.37.2
                                args:
                                    - label
                                    - pods
                                    - --all-namespaces
                                    - --selector=topology.kubernetes.io/zone!={{ .Values.zone }}
                                    - topology.kubernetes.io/zone={{ .Values.zone }}
                                    - --overwrite
                                securityContext:
                                    allowPrivilegeEscalation: false
                                    readOnlyRootFilesystem: true
                                    capabilities:
                                        drop: [ALL]
                                resources:
                                    requests:
                                        cpu: 10m
                                        memory: 32Mi
                                    limits:
                                        memory: 128Mi
    # One read-only ClusterRole per CustomResourceDefinition, aggregated into ClusterRole mcp-read (Kubernetes MCP
    # servers, helm-charts/mcp-servers/mcp-servers-raw/resources/rbac.yaml). Existing CRDs on policy creation,
    # new ones on CREATE; synchronize deletes the role when its CRD is deleted.
    - apiVersion: policies.kyverno.io/v1
      kind: GeneratingPolicy
      metadata:
          name: mcp-read-crds
      spec:
          evaluation:
              synchronize:
                  enabled: true
              generateExisting:
                  enabled: true
          matchConstraints:
              resourceRules:
                  - apiGroups: [apiextensions.k8s.io]
                    apiVersions: [v1]
                    operations: [CREATE, UPDATE]
                    resources: [customresourcedefinitions]
          # Kyverno labels the generated object with the trigger's name, and label values are limited to 63
          # characters: longer CRD names fail, so their groups are listed statically in mcp-read-builtin.
          matchConditions:
              - name: name-fits-a-label
                expression: size(object.metadata.name) <= 63
          generate:
              - template:
                    interpolate: cel
                    value: |
                        apiVersion: rbac.authorization.k8s.io/v1
                        kind: ClusterRole
                        metadata:
                          name: mcp-read-crd-(( object.metadata.name ))
                          labels:
                            homelab.rbac/aggregate-to-mcp-read: "true"
                        rules:
                          - apiGroups:
                              - (( object.spec.group ))
                            resources:
                              - (( object.spec.names.plural ))
                            verbs: [get, list, watch]
    # Lets the background controller manage those ClusterRoles. Creating a role requires holding its
    # permissions, so the controller gets read on every kind (no write verb outside clusterroles).
    - apiVersion: rbac.authorization.k8s.io/v1
      kind: ClusterRole
      metadata:
          name: kyverno:background-controller:mcp-read
          labels:
              rbac.kyverno.io/aggregate-to-background-controller: "true"
      rules:
          - apiGroups: [rbac.authorization.k8s.io]
            resources: [clusterroles]
            verbs: [get, list, watch, create, update, patch, delete]
          - apiGroups: ["*"]
            resources: ["*"]
            verbs: [get, list, watch]
    # The admission (policy status) and reports controllers must also read the policy's trigger kind, or the
    # policy stays not-ready ("missing permissions: list customresourcedefinitions") and Argo CD marks the app
    # Degraded.
    - apiVersion: rbac.authorization.k8s.io/v1
      kind: ClusterRole
      metadata:
          name: kyverno:crd-read
          labels:
              rbac.kyverno.io/aggregate-to-admission-controller: "true"
              rbac.kyverno.io/aggregate-to-reports-controller: "true"
      rules:
          - apiGroups: [apiextensions.k8s.io]
            resources: [customresourcedefinitions]
            verbs: [get, list, watch]
    # Istio ambient mode on every namespace: label istio.io/dataplane-mode=ambient, so ztunnel carries the Pods'
    # traffic (mTLS between Pods, L4 telemetry, AuthorizationPolicy). Not labelled:
    #   - kube-* (control plane and node components) and istio-system (ztunnel and istiod must stay outside
    #     the mesh they implement);
    #   - calico-system and tigera-operator are set to "none": the Calico operator's default-deny policy there
    #     (managed by homelab-ansible) would drop ztunnel's HBONE port 15008, and their Pods are mostly hostNetwork;
    #   - any other namespace that already has the label keeps its value (set "none" to opt a namespace out).
    # Gateway Pods opt out by themselves (Istio sets istio.io/dataplane-mode=none on them); hostNetwork Pods
    # (Calico, MetalLB speaker, node-exporter) are never captured. Existing namespaces are labelled by the
    # background controller (mutateExisting); new ones at admission. Running Pods join without a restart.
    - apiVersion: policies.kyverno.io/v1
      kind: MutatingPolicy
      metadata:
          name: namespace-ambient-mode
      spec:
          failurePolicy: Ignore
          evaluation:
              mutateExisting:
                  enabled: true
          matchConstraints:
              resourceRules:
                  - apiGroups: [""]
                    apiVersions: [v1]
                    operations: [CREATE, UPDATE]
                    resources: [namespaces]
          variables:
              - name: optOut
                expression: object.metadata.name in ['calico-system', 'tigera-operator']
              - name: mode
                expression: "variables.optOut ? 'none' : 'ambient'"
          matchConditions:
              - name: not-system
                expression: >-
                    !object.metadata.name.startsWith('kube-') && object.metadata.name != 'istio-system'
              - name: needs-label
                expression: >-
                    !has(object.metadata.labels) || !('istio.io/dataplane-mode' in object.metadata.labels) ||
                    (object.metadata.name in ['calico-system', 'tigera-operator'] &&
                    object.metadata.labels['istio.io/dataplane-mode'] != 'none')
          mutations:
              - patchType: ApplyConfiguration
                applyConfiguration:
                    expression: >-
                        Object{metadata: Object.metadata{labels: {"istio.io/dataplane-mode": variables.mode}}}
    # The background controller updates existing Namespaces (mutateExisting above)
    - apiVersion: rbac.authorization.k8s.io/v1
      kind: ClusterRole
      metadata:
          name: kyverno:background-controller:namespace-ambient
          labels:
              rbac.kyverno.io/aggregate-to-background-controller: "true"
      rules:
          - apiGroups: [""]
            resources: [namespaces]
            verbs: [get, list, watch, update, patch]
