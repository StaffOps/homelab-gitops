resources:
    - apiVersion: gateway.networking.k8s.io/v1
      kind: HTTPRoute
      metadata:
          name: vault
      spec:
          parentRefs:
              - name: {{ .Values.gateway.name }}
                namespace: {{ .Values.gateway.namespace }}
                sectionName: https
          hostnames:
              - vault.{{ .Values.domain }}
          rules:
              - backendRefs:
                    - name: vault-ui
                      port: 8200
    - apiVersion: monitoring.coreos.com/v1
      kind: PrometheusRule
      metadata:
          name: vault
      spec:
          {{- readFile "./prometheus.rules.yaml" | nindent 10 }}
