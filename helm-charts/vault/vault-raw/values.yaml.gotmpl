resources:
    # Kubernetes auth role "apps" selects namespaces by label (bound_service_account_namespace_selector,
    # staffops.space/tier=apps): Vault must read the Namespace of each login.
    - apiVersion: rbac.authorization.k8s.io/v1
      kind: ClusterRole
      metadata:
          name: vault-namespace-read
      rules:
          - apiGroups: [""]
            resources: [namespaces]
            verbs: [get]
    - apiVersion: rbac.authorization.k8s.io/v1
      kind: ClusterRoleBinding
      metadata:
          name: vault-namespace-read
      roleRef:
          apiGroup: rbac.authorization.k8s.io
          kind: ClusterRole
          name: vault-namespace-read
      subjects:
          - kind: ServiceAccount
            name: vault
            namespace: vault
    - apiVersion: gateway.networking.k8s.io/v1
      kind: HTTPRoute
      metadata:
          name: vault
      spec:
          parentRefs:
              - name: {{ .Values.gateway.name }}
                namespace: {{ .Values.gateway.namespace }}
                sectionName: https
          hostnames:
              - vault.{{ .Values.domain }}
          rules:
              - backendRefs:
                    - name: vault-ui
                      port: 8200
    - apiVersion: monitoring.coreos.com/v1
      kind: PrometheusRule
      metadata:
          name: vault
      spec:
          {{- readFile "./prometheus.rules.yaml" | nindent 10 }}
    # Auto-unseal after a reboot (homelab trade-off, see docs/adr/0005): every 5 minutes, unseal vault-0 if it is
    # sealed, with the single unseal key from Secret vault-unseal. That Secret is NOT in git: it is created
    # once with `scripts/vault.sh autounseal-secret` (encrypted at rest by the API server). Without it the
    # Job just fails to start and Vault stays sealed as before.
    - apiVersion: v1
      kind: ServiceAccount
      metadata:
          name: vault-autounseal
      automountServiceAccountToken: false
    - apiVersion: batch/v1
      kind: CronJob
      metadata:
          name: vault-autounseal
      spec:
          schedule: "*/5 * * * *" # a reboot heals within 5 minutes
          concurrencyPolicy: Forbid
          successfulJobsHistoryLimit: 1
          failedJobsHistoryLimit: 3
          jobTemplate:
              spec:
                  backoffLimit: 0
                  activeDeadlineSeconds: 50
                  ttlSecondsAfterFinished: 300
                  template:
                      spec:
                          serviceAccountName: vault-autounseal
                          automountServiceAccountToken: false
                          restartPolicy: Never
                          securityContext:
                              runAsNonRoot: true
                              runAsUser: 100
                              seccompProfile:
                                  type: RuntimeDefault
                          containers:
                              - name: unseal
                                image: hashicorp/vault:2.0.4 # same image as the server
                                securityContext:
                                    allowPrivilegeEscalation: false
                                    readOnlyRootFilesystem: true
                                    capabilities:
                                        drop: [ALL]
                                env:
                                    - name: VAULT_ADDR
                                      value: http://vault.vault.svc:8200
                                    - name: HOME
                                      value: /tmp
                                command: [/bin/sh, -c]
                                # vault status: exit 0 unsealed, 2 sealed, 1 unreachable (nothing to do)
                                args:
                                    - |
                                      vault status >/dev/null 2>&1; rc=$?
                                      [ "$rc" -eq 2 ] || exit 0
                                      vault write -format=json sys/unseal key=@/unseal/key >/dev/null && echo "unsealed vault-0"
                                volumeMounts:
                                    - name: unseal
                                      mountPath: /unseal
                                      readOnly: true
                                    - name: tmp
                                      mountPath: /tmp
                                resources:
                                    requests:
                                        cpu: 10m
                                        memory: 32Mi
                                    limits:
                                        memory: 64Mi
                          volumes:
                              - name: unseal
                                secret:
                                    secretName: vault-unseal
                              - name: tmp
                                emptyDir: {}
