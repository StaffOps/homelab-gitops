resources:
    - apiVersion: metallb.io/v1beta1
      kind: IPAddressPool
      metadata:
          name: lan
      spec:
          addresses:
              {{- toYaml .Values.metallb.addresses | nindent 14 }}
    - apiVersion: metallb.io/v1beta1
      kind: L2Advertisement
      metadata:
          name: lan
      spec:
          ipAddressPools:
              - lan
