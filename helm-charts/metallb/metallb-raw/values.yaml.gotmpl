resources:
    - apiVersion: metallb.io/v1beta1
      kind: IPAddressPool
      metadata:
          name: lan
      spec:
          addresses:
              {{- toYaml .Values.metallb.addresses | nindent 14 }}
    - apiVersion: metallb.io/v1beta1
      kind: L2Advertisement
      metadata:
          name: lan
      spec:
          ipAddressPools:
              - lan
    # PrometheusRule: rules inserted as-is (no tpl), so they keep plain Prometheus templates
    - apiVersion: monitoring.coreos.com/v1
      kind: PrometheusRule
      metadata:
          name: metallb-announcements
      spec:
          {{- readFile "./prometheus.rules.yaml" | nindent 10 }}
