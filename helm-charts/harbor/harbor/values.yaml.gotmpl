{{- $gw := .Values.gateway }}
{{- $host := printf "harbor.%s" .Values.domain }}
# TLS ends at the shared Gateway (wildcard certificate): the chart only renders an HTTPRoute to core and portal
expose:
    type: route
    tls:
        enabled: false
    route:
        parentRefs:
            - name: {{ $gw.name }}
              namespace: {{ $gw.namespace }}
              sectionName: https
        hosts:
            - {{ $host }}
externalURL: https://{{ $host }}
persistence:
    enabled: true
    resourcePolicy: keep # PVCs survive an uninstall
    persistentVolumeClaim:
        registry:
            storageClass: {{ .Values.storageClass }}
            size: 50Gi # local-path does not enforce it; the node disk is the limit
        jobservice:
            jobLog:
                storageClass: {{ .Values.storageClass }}
                size: 1Gi
        redis:
            storageClass: {{ .Values.storageClass }}
            size: 1Gi
        trivy:
            storageClass: {{ .Values.storageClass }}
            size: 5Gi
    imageChartStorage:
        # Filesystem on the node. R2 is not used: the registry's S3 driver uploads layers in parts of different
        # sizes, which R2 rejects ("All non-trailing parts must have the same length").
        type: filesystem
# Secrets: Vault homelab/harbor (admin password, encryption key) and harbor-internal (generated once by External
# Secrets). Without them the chart generates new random values on every render and Argo CD restarts Harbor.
existingSecretAdminPassword: harbor-vault
existingSecretAdminPasswordKey: HARBOR_ADMIN_PASSWORD
existingSecretSecretKey: harbor-vault # key secretKey (16 chars, encrypts credentials Harbor stores)
internalTLS:
    enabled: false
logLevel: info
metrics:
    enabled: true
    serviceMonitor:
        enabled: true
cache:
    enabled: true
    expireHours: 24
updateStrategy:
    type: Recreate # RWO volumes on one node
portal:
    resources:
        requests:
            cpu: 10m
            memory: 32Mi
        limits:
            memory: 128Mi
core:
    existingSecret: harbor-internal # key secret
    existingXsrfSecret: harbor-internal
    existingXsrfSecretKey: CSRF_KEY
    secretName: harbor-token # token-signing key pair (cert-manager Certificate in harbor-raw)
    # Login with Keycloak: CONFIG_OVERWRITE_JSON (built by the ExternalSecret harbor-oidc) is applied at every start
    extraEnvVars:
        - name: CONFIG_OVERWRITE_JSON
          valueFrom:
              secretKeyRef:
                  name: harbor-oidc
                  key: CONFIG_OVERWRITE_JSON
    resources:
        requests:
            cpu: 50m
            memory: 128Mi
        limits:
            memory: 512Mi
jobservice:
    existingSecret: harbor-internal
    existingSecretKey: JOBSERVICE_SECRET
    loggerSweeperDuration: 14
    resources:
        requests:
            cpu: 20m
            memory: 64Mi
        limits:
            memory: 256Mi
registry:
    existingSecret: harbor-internal
    existingSecretKey: REGISTRY_HTTP_SECRET
    credentials:
        username: harbor_registry_user
        existingSecret: harbor-internal # keys REGISTRY_PASSWD, REGISTRY_HTPASSWD
    registry:
        resources:
            requests:
                cpu: 20m
                memory: 64Mi
            limits:
                memory: 512Mi
    controller:
        resources:
            requests:
                cpu: 10m
                memory: 32Mi
            limits:
                memory: 128Mi
    upload_purging:
        enabled: true
        age: 168h
        interval: 24h
        dryrun: false
trivy:
    enabled: true
    resources:
        requests:
            cpu: 20m
            memory: 128Mi
        limits:
            memory: 1Gi
database:
    type: external
    external:
        host: harbor-db-rw # CloudNativePG Cluster harbor-db (harbor-raw)
        port: "5432"
        username: harbor
        coreDatabase: registry
        existingSecret: harbor-db-app # generated by CloudNativePG, key password
        sslmode: require
    maxIdleConns: 10
    maxOpenConns: 50
redis:
    type: internal
    internal:
        resources:
            requests:
                cpu: 10m
                memory: 32Mi
            limits:
                memory: 256Mi
exporter:
    resources:
        requests:
            cpu: 10m
            memory: 32Mi
        limits:
            memory: 128Mi
