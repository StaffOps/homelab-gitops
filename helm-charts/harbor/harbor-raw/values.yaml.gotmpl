# One file per object group in resources/, rendered with the helmfile values (tpl). bedag/raw does not run tpl
# again, so External Secrets template expressions are escaped once: {{`{{ .x }}`}}.
resources:
    {{- range $f := readDir "./resources" }}
    {{- tpl (readFile (printf "./%s" $f)) $ | nindent 4 }}
    {{- end }}
    # Alert rules (sources in the file). Outside resources/ because that directory goes through tpl and the rules
    # hold Prometheus templates: readFile inserts them as-is.
    - apiVersion: monitoring.coreos.com/v1
      kind: PrometheusRule
      metadata:
          name: harbor
      spec:
          {{- readFile "./prometheus.rules.yaml" | nindent 10 }}
