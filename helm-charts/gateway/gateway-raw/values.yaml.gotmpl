{{- $gw := .Values.gateway }}
{{- $wildcard := printf "*.%s" .Values.domain }}
resources:
    # Wildcard certificate used by the https listener
    - apiVersion: cert-manager.io/v1
      kind: Certificate
      metadata:
          name: wildcard
      spec:
          secretName: wildcard-tls
          issuerRef:
              kind: ClusterIssuer
              name: letsencrypt-prod
          dnsNames:
              - '{{ $wildcard }}'
              - '{{ .Values.domain }}'
          privateKey:
              algorithm: ECDSA
              size: 256
              rotationPolicy: Always
    - apiVersion: gateway.networking.k8s.io/v1
      kind: Gateway
      metadata:
          name: {{ $gw.name }}
      spec:
          gatewayClassName: istio
          addresses:
              - type: IPAddress
                value: {{ $gw.address }}
          listeners:
              - name: http
                protocol: HTTP
                port: 80
                hostname: '{{ $wildcard }}'
                allowedRoutes:
                    namespaces:
                        from: Same # only the redirect below
              - name: https
                protocol: HTTPS
                port: 443
                hostname: '{{ $wildcard }}'
                tls:
                    mode: Terminate
                    certificateRefs:
                        - name: wildcard-tls
                allowedRoutes:
                    namespaces:
                        from: All
    # http → https for every hostname
    - apiVersion: gateway.networking.k8s.io/v1
      kind: HTTPRoute
      metadata:
          name: https-redirect
      spec:
          parentRefs:
              - name: {{ $gw.name }}
                sectionName: http
          rules:
              - filters:
                    - type: RequestRedirect
                      requestRedirect:
                          scheme: https
                          statusCode: 301
