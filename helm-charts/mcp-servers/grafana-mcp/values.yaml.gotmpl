fullnameOverride: grafana-mcp
grafana:
    url: http://grafana.monitoring
    apiKeySecret:
        name: mcp-credentials # ExternalSecret in mcp-servers-raw (Vault homelab/mcp: grafana-token)
        key: grafana-token
disableWrite: true
# No own bearer token: callers authenticate at the Gateway "mcp" (Keycloak JWT), which strips the
# Authorization header before forwarding; a chart-generated token would reject every request with 401.
serverAuth:
    token: null
extraArgs:
    - -t
    - streamable-http
    # Host header check (DNS-rebinding protection): requests arrive through the Gateway as mcp.<domain>
    - --allowed-hosts
    - mcp.{{ .Values.domain }}
resources:
    requests:
        cpu: 10m
        memory: 64Mi
    limits:
        memory: 256Mi
