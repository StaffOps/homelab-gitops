fullnameOverride: grafana-mcp
grafana:
    url: http://grafana.monitoring
    apiKeySecret:
        name: mcp-credentials # ExternalSecret in mcp-servers-raw (Vault homelab/mcp: grafana-token)
        key: grafana-token
disableWrite: true
# No own bearer token: callers authenticate at the Gateway "mcp" (Keycloak JWT), which strips the
# Authorization header before forwarding; a chart-generated token would reject every request with 401.
serverAuth:
    token: null
extraArgs:
    - -t
    - streamable-http
    # Host header check (DNS-rebinding protection): requests arrive through the Gateway as mcp.<domain>
    - --allowed-hosts
    - mcp.{{ .Values.domain }}
# Prometheus metrics (--metrics) on their own listener (--metrics-address=:9090, Service port "metrics"): the
# MCP port enforces the Host check above, so a scrape by pod IP there gets 403. The HTTPRoute only targets the
# MCP port, so metrics are not reachable through the Gateway.
metrics:
    enabled: true
    port: 9090
serviceMonitor:
    enabled: true
resources:
    requests:
        cpu: 10m
        memory: 64Mi
    limits:
        memory: 256Mi
