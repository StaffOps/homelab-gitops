resources:
    - apiVersion: monitoring.coreos.com/v1
      kind: ServiceMonitor
      metadata:
          name: istiod
      spec:
          selector:
              matchLabels:
                  app: istiod
          endpoints:
              - port: http-monitoring
                interval: 30s
    - apiVersion: monitoring.coreos.com/v1
      kind: PodMonitor
      metadata:
          name: ztunnel
      spec:
          selector:
              matchLabels:
                  app: ztunnel
          podMetricsEndpoints:
              - portNumber: 15020
                path: /stats/prometheus
                interval: 30s
    # Envoy of the Gateway API gateways (any namespace), e.g. gateway/public
    - apiVersion: monitoring.coreos.com/v1
      kind: PodMonitor
      metadata:
          name: gateway-envoy
      spec:
          namespaceSelector:
              any: true
          selector:
              matchExpressions:
                  - key: gateway.networking.k8s.io/gateway-name
                    operator: Exists
          podMetricsEndpoints:
              - portNumber: 15090
                path: /stats/prometheus
                interval: 30s
