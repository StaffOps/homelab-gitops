autoscaleEnabled: false
# 2 replicas (not HA: one node): a crash, restart or rollout of one Pod does not stop it. No PDB (single node). Certificates and config for ztunnel and the Gateways; three webhooks fail closed.
replicaCount: 2
resources:
    requests:
        cpu: 100m
        memory: 256Mi
    limits:
        memory: 1Gi
global:
    logAsJson: true
    defaultPodDisruptionBudget:
        enabled: false # single node: a PDB would only block drains
meshConfig:
    accessLogFile: /dev/stdout
    accessLogEncoding: JSON
    defaultConfig:
        # Extra Envoy stats for the Gateway proxies (Istio keeps only xds-grpc/server/listener_manager stats by
        # default): per-backend endpoint health, connect failures, timeouts/retries/overflow and TLS handshake errors
        # for the "Ingress / Gateway" dashboard. Each gateway has ~150 clusters (every Service), so keep this list
        # to what the dashboard uses (~2k series). Read at proxy start: restart the gateway Deployments
        # (gateway/public-istio, gateway/mcp-istio) once after a change.
        # https://istio.io/latest/docs/ops/configuration/telemetry/envoy-stats/
        proxyStatsMatcher:
            inclusionRegexps:
                - 'cluster\.outbound\|.*\.(membership_healthy|membership_total|upstream_cx_connect_fail|upstream_cx_connect_timeout|upstream_rq_timeout|upstream_rq_retry|upstream_rq_pending_overflow)$'
                - 'listener\..*\.ssl\.(handshake|connection_error)$'
