fullnameOverride: local-path-provisioner
image:
    tag: v0.0.37
helperImage:
    tag: 1.38.0 # busybox; the chart defaults to latest
storageClass:
    name: {{ .Values.storageClass }}
    defaultClass: true # PVCs without storageClassName land here
    reclaimPolicy: Delete
    volumeBindingMode: WaitForFirstConsumer
nodePathMap:
    - node: DEFAULT_PATH_FOR_NON_LISTED_NODES
      paths:
          - /opt/local-path-provisioner
resources:
    requests:
        cpu: 10m
        memory: 32Mi
    limits:
        memory: 128Mi
