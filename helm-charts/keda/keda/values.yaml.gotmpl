# Single node: one replica of each component
operator:
    replicaCount: 1
metricsServer:
    replicaCount: 1
webhooks:
    replicaCount: 1
prometheus:
    metricServer:
        enabled: true
        serviceMonitor:
            enabled: true
    operator:
        enabled: true
        serviceMonitor:
            enabled: true
        # Chart example uses the removed keda_metrics_adapter_scaler_errors; current name per KEDA 2.21 docs
        prometheusRules:
            enabled: true
            alerts:
                - alert: KedaScalerErrors
                  expr: sum by (exported_namespace, scaledObject, scaler) (rate(keda_scaler_detail_errors_total[5m])) > 0
                  for: 10m
                  labels:
                      severity: warning
                  annotations:
                      summary: 'KEDA scaler {{`{{ $labels.scaler }}`}} of {{`{{ $labels.exported_namespace }}/{{ $labels.scaledObject }}`}} is failing'
                - alert: KedaScaledObjectErrors
                  expr: sum by (exported_namespace, scaledObject) (rate(keda_scaled_object_errors_total[5m])) > 0
                  for: 10m
                  labels:
                      severity: warning
                  annotations:
                      summary: 'KEDA cannot handle ScaledObject {{`{{ $labels.exported_namespace }}/{{ $labels.scaledObject }}`}}'
    webhooks:
        enabled: true
        serviceMonitor:
            enabled: true
resources:
    operator:
        requests:
            cpu: 20m
            memory: 96Mi
        limits:
            memory: 512Mi
    metricServer:
        requests:
            cpu: 20m
            memory: 96Mi
        limits:
            memory: 512Mi
    webhooks:
        requests:
            cpu: 10m
            memory: 64Mi
        limits:
            memory: 256Mi
