# Single node: one replica of each component
operator:
    replicaCount: 1
metricsServer:
    replicaCount: 1
webhooks:
    replicaCount: 1
prometheus:
    metricServer:
        enabled: true
        serviceMonitor:
            enabled: true
    operator:
        enabled: true
        serviceMonitor:
            enabled: true
    webhooks:
        enabled: true
        serviceMonitor:
            enabled: true
resources:
    operator:
        requests:
            cpu: 20m
            memory: 192Mi
        limits:
            memory: 512Mi
    metricServer:
        requests:
            cpu: 20m
            memory: 192Mi
        limits:
            memory: 512Mi
    webhooks:
        requests:
            cpu: 10m
            memory: 64Mi
        limits:
            memory: 256Mi
