# One file per object group in resources/, rendered with the helmfile values (tpl). Argo Rollouts expressions
# (args.x between double braces) are escaped once in those files.
resources:
    {{- range $f := readDir "./resources" }}
    {{- tpl (readFile (printf "./%s" $f)) $ | nindent 4 }}
    {{- end }}
    # PrometheusRule: rules inserted as-is (no tpl), so they keep plain Prometheus templates
    - apiVersion: monitoring.coreos.com/v1
      kind: PrometheusRule
      metadata:
          name: argo-rollouts
      spec:
          {{- readFile "./prometheus.rules.yaml" | nindent 10 }}
