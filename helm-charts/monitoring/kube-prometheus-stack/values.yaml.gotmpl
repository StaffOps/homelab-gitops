# Short names. Prometheus, Alertmanager and their Services always carry the chart fullname, so it is "kps":
# Prometheus/Alertmanager objects "kps" (pods prometheus-kps-0, alertmanager-kps-0), Services kps-prometheus
# and kps-alertmanager. Sub-charts and the operator get plain names.
fullnameOverride: kps
cleanPrometheusOperatorObjectNames: true # only safe on a fresh install (PVC names change)
crds:
    enabled: false # prometheus-operator-crds installed by bootstrap.sh
# Control-plane scraping. kubeadm binds these to 127.0.0.1 by default; the host (homelab-ansible) must
# listen on the node IP first, otherwise the targets are down (and their absent alerts fire):
#   kube-controller-manager / kube-scheduler: --bind-address=0.0.0.0
#   etcd: --listen-metrics-urls=http://127.0.0.1:2381,http://192.168.68.104:2381
#   kube-proxy: metricsBindAddress 0.0.0.0:10249 (ConfigMap kube-proxy)
# The chart's headless Services in kube-system select the static pods / DaemonSet by label (hostNetwork:
# endpoints are the node IP), so no static `endpoints:` list. Chart defaults for kube >= 1.23: https on
# 10257/10259 with the Prometheus ServiceAccount token (its ClusterRole grants GET on /metrics) and
# insecureSkipVerify (self-signed serving certs for 127.0.0.1/localhost).
# kube-apiserver is ~30 % of all series. First rule = the chart default (setting the list replaces it); the second
# drops histograms no rule or dashboard here uses (~34k series): watch dispatch/list, storage list, request body size,
# watch-cache timings. Re-enable one by removing it from the regex when debugging that path.
kubeApiServer:
    serviceMonitor:
        metricRelabelings:
            - action: drop
              regex: (etcd_request|apiserver_request_slo|apiserver_request_sli|apiserver_request)_duration_seconds_bucket;(0\.15|0\.2|0\.3|0\.35|0\.4|0\.45|0\.6|0\.7|0\.8|0\.9|1\.25|1\.5|1\.75|2|3|3\.5|4|4\.5|6|7|8|9|15|20|40|45|50)(\.0)?
              sourceLabels: [__name__, le]
            - action: drop
              regex: apiserver_(watch_events_dispatch_duration_seconds|watch_list_duration_seconds|storage_list_duration_seconds|request_body_size_bytes|watch_cache_read_wait_seconds|watch_cache_initialization_duration_seconds)_bucket
              sourceLabels: [__name__]
kubeControllerManager:
    enabled: true
kubeScheduler:
    enabled: true
# Plain http on 10249 and 2381 needs no authentication: do not send the ServiceAccount token in clear.
kubeProxy:
    enabled: true
    serviceMonitor:
        authorization: null
kubeEtcd:
    enabled: true
    serviceMonitor:
        authorization: null
prometheusOperator:
    fullnameOverride: prometheus-operator
    # config-reloader sidecar of Prometheus and Alertmanager
    prometheusConfigReloader:
        resources:
            requests:
                cpu: 5m
                memory: 32Mi
            limits:
                memory: 64Mi
    resources:
        requests:
            cpu: 50m
            memory: 128Mi
        limits:
            memory: 256Mi
prometheus:
    prometheusSpec:
        # Select every ServiceMonitor/PodMonitor/PrometheusRule/Probe, not only the chart's own
        serviceMonitorSelectorNilUsesHelmValues: false
        podMonitorSelectorNilUsesHelmValues: false
        ruleSelectorNilUsesHelmValues: false
        probeSelectorNilUsesHelmValues: false
        scrapeConfigSelectorNilUsesHelmValues: false
        # Label cluster=<cluster.name of the environment> on every scraped series (default scrape class: every
        # ServiceMonitor/PodMonitor/Probe/ScrapeConfig without its own class). The VPS series arrive by remote-write
        # with cluster=vps (Alloy), so dashboards and rules tell the clusters apart (kubernetes-mixin $cluster).
        scrapeClasses:
            - name: cluster
              default: true
              relabelings:
                  - action: replace
                    targetLabel: cluster
                    replacement: {{ .Values.cluster.name }}
        # Remote-write from edge clusters (Alloy on the VPS, cluster="vps") at prometheus.<domain>/api/v1/write, reachable
        # from the LAN and the tailnet only (Gateway public)
        enableRemoteWriteReceiver: true
        # OTLP metrics from the otel-gateway (apps, OBI, span metrics, service graph): /api/v1/otlp
        enableOTLPReceiver: true
        otlp:
            translationStrategy: UnderscoreEscapingWithSuffixes
            keepIdentifyingResourceAttributes: true
            promoteResourceAttributes:
                - cluster
                - service.name
                - service.namespace
                - service.version
                - k8s.cluster.name
                - k8s.namespace.name
                - k8s.pod.name
                - k8s.container.name
                - k8s.deployment.name
                - k8s.statefulset.name
                - k8s.daemonset.name
                - k8s.node.name
        # Exemplars from OTLP ingestion (SDK trace_based filter): stored in memory, queried at /api/v1/query_exemplars
        # and shown on panels linking to Tempo (Prometheus datasource exemplarTraceIdDestinations below)
        enableFeatures:
            - exemplar-storage
        exemplars:
            maxSize: 100000
        retention: 15d
        retentionSize: 18GB
        externalUrl: https://prometheus.{{ .Values.domain }}
        resources:
            requests:
                cpu: 100m
                memory: 2Gi
            limits:
                memory: 4Gi
        storageSpec:
            volumeClaimTemplate:
                spec:
                    storageClassName: {{ .Values.storageClass }}
                    accessModes: [ReadWriteOnce]
                    resources:
                        requests:
                            storage: 20Gi
alertmanager:
    alertmanagerSpec:
        externalUrl: https://alertmanager.{{ .Values.domain }}
        resources:
            requests:
                cpu: 10m
                memory: 64Mi
            limits:
                memory: 128Mi
        storage:
            volumeClaimTemplate:
                spec:
                    storageClassName: {{ .Values.storageClass }}
                    accessModes: [ReadWriteOnce]
                    resources:
                        requests:
                            storage: 1Gi
grafana:
    fullnameOverride: grafana
    admin:
        existingSecret: grafana-admin # ExternalSecret in monitoring-raw (Vault homelab/grafana)
        userKey: admin-user
        passwordKey: admin-password
    # Loki and Tempo, linked both ways (trace → logs of the same pod, log trace_id → trace)
    additionalDataSources:
        - name: Loki
          uid: loki
          type: loki
          url: http://loki.monitoring:3100
          jsonData:
              derivedFields:
                  - name: trace_id
                    matcherType: label
                    matcherRegex: ^trace_id$ # anchored: the label matcher is a regex on label keys (parent_trace_id would match too)
                    datasourceUid: tempo
                    url: "$${__value.raw}"
        - name: Tempo
          uid: tempo
          type: tempo
          url: http://tempo.monitoring:3200
          jsonData:
              serviceMap:
                  datasourceUid: prometheus # service graph from the otel-gateway (traces_service_graph_*)
              nodeGraph:
                  enabled: true
              # OTLP logs carry trace_id as Loki structured metadata, not in the line: filter on it ($$ escapes the
              # provisioning env-var expansion)
              tracesToLogsV2:
                  datasourceUid: loki
                  spanStartTimeShift: -5m
                  spanEndTimeShift: 5m
                  customQuery: true
                  query: '{service_name="$${__span.tags["service.name"]}"} | trace_id="$${__trace.traceId}"'
              lokiSearch:
                  datasourceUid: loki
    envValueFrom:
        GF_AUTH_GENERIC_OAUTH_CLIENT_SECRET:
            secretKeyRef:
                name: grafana-oidc # ExternalSecret in monitoring-raw (Vault homelab/oidc: grafana)
                key: client-secret
        # Database: CloudNativePG Cluster grafana-db (monitoring-raw), backed up to R2 like the other databases
        GF_DATABASE_PASSWORD:
            secretKeyRef:
                name: grafana-db-app
                key: password
    # Data lives in PostgreSQL (grafana-db); the pod keeps only plugins/cache on an emptyDir
    persistence:
        enabled: false
    grafana.ini:
        server:
            root_url: https://grafana.{{ .Values.domain }}
        # Login with Keycloak (realm keycloak.realm, client grafana); groups /grafana/admin → Admin, /grafana/viewer → Viewer, others denied
        auth.generic_oauth:
            enabled: true
            name: Keycloak
            allow_sign_up: true
            client_id: grafana
            scopes: openid profile email groups
            auth_url: https://keycloak.{{ .Values.domain }}/realms/{{ .Values.keycloak.realm }}/protocol/openid-connect/auth
            token_url: https://keycloak.{{ .Values.domain }}/realms/{{ .Values.keycloak.realm }}/protocol/openid-connect/token
            api_url: https://keycloak.{{ .Values.domain }}/realms/{{ .Values.keycloak.realm }}/protocol/openid-connect/userinfo
            signout_redirect_url: https://keycloak.{{ .Values.domain }}/realms/{{ .Values.keycloak.realm }}/protocol/openid-connect/logout?post_logout_redirect_uri=https%3A%2F%2Fgrafana.{{ .Values.domain }}%2Flogin
            use_pkce: true
            login_attribute_path: preferred_username
            role_attribute_path: contains(groups[*], '/grafana/admin') && 'Admin' || contains(groups[*], '/grafana/viewer') && 'Viewer'
            role_attribute_strict: true # no matching group → login refused
            allow_assign_grafana_admin: true
        database:
            type: postgres
            host: grafana-db-rw:5432
            name: grafana
            user: grafana
            ssl_mode: require
        analytics:
            check_for_updates: false
            reporting_enabled: false
    resources:
        requests:
            cpu: 50m
            memory: 384Mi
        limits:
            memory: 768Mi
    # dashboard/datasource sidecars (k8s-sidecar). Dashboards go to the Grafana folder named by the ConfigMap
    # annotation grafana_folder (monitoring-raw/dashboards/<folder>/); the chart's own dashboards → "Kubernetes".
    sidecar:
        # default Prometheus datasource (uid prometheus): exemplar trace_id → Tempo
        datasources:
            exemplarTraceIdDestinations:
                datasourceUid: tempo
                traceIdLabelName: trace_id
                urlDisplayLabel: View trace
        dashboards:
            folderAnnotation: grafana_folder
            provider:
                foldersFromFilesStructure: true
            annotations:
                grafana_folder: Kubernetes
        resources:
            requests:
                cpu: 10m
                memory: 96Mi
            limits:
                memory: 192Mi
kube-state-metrics:
    fullnameOverride: kube-state-metrics
    # kube_node_labels only exists for allow-listed labels; the CloudNativePG dashboard joins pods to the node zone
    metricLabelsAllowlist:
        - nodes=[topology.kubernetes.io/zone]
    # Scrape its own telemetry port (8081: kube_state_metrics_list_total/watch_total): without it the mixin alerts
    # KubeStateMetricsListErrors/WatchErrors can never fire (Cluster add-ons dashboard uses the same series)
    selfMonitor:
        enabled: true
    resources:
        requests:
            cpu: 10m
            memory: 96Mi
        limits:
            memory: 192Mi
# Only the Linux node-exporter dashboards: the AIX and macOS ones query metrics a Linux node never exports
nodeExporter:
    operatingSystems:
        aix:
            enabled: false
        darwin:
            enabled: false
prometheus-node-exporter:
    fullnameOverride: node-exporter
    resources:
        requests:
            cpu: 10m
            memory: 32Mi
        limits:
            memory: 64Mi
defaultRules:
    rules:
        # the chart's copy selects job="kps-operator" (ignores fullnameOverride); fixed copy below
        prometheusOperator: false
    disabled:
        etcdGRPCRequestsSlow: true # lab copy in etcd.rules.yaml (Status excluded)
# Alert rules the chart does not ship (inserted as-is with readFile: plain Prometheus templates in the file).
# Only where Prometheus runs (k8s01): an edge environment has no PrometheusRule CRD, and an overlay cannot drop
# these keys (the chart fails on a null entry).
{{- if eq .Environment.Name "default" }}
additionalPrometheusRulesMap:
    coredns:
        {{- readFile "./coredns.rules.yaml" | nindent 8 }}
    prometheus-operator:
        {{- readFile "./prometheus-operator.rules.yaml" | nindent 8 }}
    etcd-lab:
        {{- readFile "./etcd.rules.yaml" | nindent 8 }}
{{- end }}
