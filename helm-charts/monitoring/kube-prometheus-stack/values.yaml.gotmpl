# Short names. Prometheus, Alertmanager and their Services always carry the chart fullname, so it is "kps":
# Prometheus/Alertmanager objects "kps" (pods prometheus-kps-0, alertmanager-kps-0), Services kps-prometheus
# and kps-alertmanager. Sub-charts and the operator get plain names.
fullnameOverride: kps
cleanPrometheusOperatorObjectNames: true # only safe on a fresh install (PVC names change)
crds:
    enabled: false # prometheus-operator-crds installed by bootstrap.sh
# kubeadm binds controller-manager, scheduler, etcd metrics and kube-proxy metrics to 127.0.0.1, out of
# Prometheus' reach. Enabling these needs the bind addresses changed on the host (Ansible) first.
kubeControllerManager:
    enabled: false
kubeScheduler:
    enabled: false
kubeProxy:
    enabled: false
kubeEtcd:
    enabled: false
defaultRules:
    rules:
        kubeControllerManager: false
        kubeSchedulerAlerting: false
        kubeSchedulerRecording: false
        kubeProxy: false
        etcd: false
prometheusOperator:
    fullnameOverride: prometheus-operator
    resources:
        requests:
            cpu: 50m
            memory: 128Mi
        limits:
            memory: 256Mi
prometheus:
    prometheusSpec:
        # Select every ServiceMonitor/PodMonitor/PrometheusRule/Probe, not only the chart's own
        serviceMonitorSelectorNilUsesHelmValues: false
        podMonitorSelectorNilUsesHelmValues: false
        ruleSelectorNilUsesHelmValues: false
        probeSelectorNilUsesHelmValues: false
        scrapeConfigSelectorNilUsesHelmValues: false
        # OTLP metrics from the otel-gateway (apps, OBI, span metrics, service graph): /api/v1/otlp
        enableOTLPReceiver: true
        otlp:
            translationStrategy: UnderscoreEscapingWithSuffixes
            keepIdentifyingResourceAttributes: true
            promoteResourceAttributes:
                - service.name
                - service.namespace
                - service.version
                - k8s.cluster.name
                - k8s.namespace.name
                - k8s.pod.name
                - k8s.container.name
                - k8s.deployment.name
                - k8s.statefulset.name
                - k8s.daemonset.name
                - k8s.node.name
        retention: 15d
        retentionSize: 18GB
        externalUrl: https://prometheus.{{ .Values.domain }}
        resources:
            requests:
                cpu: 200m
                memory: 1Gi
            limits:
                memory: 3Gi
        storageSpec:
            volumeClaimTemplate:
                spec:
                    storageClassName: {{ .Values.storageClass }}
                    accessModes: [ReadWriteOnce]
                    resources:
                        requests:
                            storage: 20Gi
alertmanager:
    alertmanagerSpec:
        externalUrl: https://alertmanager.{{ .Values.domain }}
        resources:
            requests:
                cpu: 10m
                memory: 32Mi
            limits:
                memory: 128Mi
        storage:
            volumeClaimTemplate:
                spec:
                    storageClassName: {{ .Values.storageClass }}
                    accessModes: [ReadWriteOnce]
                    resources:
                        requests:
                            storage: 1Gi
grafana:
    fullnameOverride: grafana
    admin:
        existingSecret: grafana-admin # ExternalSecret in monitoring-raw (Vault homelab/grafana)
        userKey: admin-user
        passwordKey: admin-password
    # Loki and Tempo, linked both ways (trace → logs of the same pod, log trace_id → trace)
    additionalDataSources:
        - name: Loki
          uid: loki
          type: loki
          url: http://loki.monitoring:3100
          jsonData:
              derivedFields:
                  - name: trace_id
                    matcherType: label
                    matcherRegex: trace_id
                    datasourceUid: tempo
                    url: "$${__value.raw}"
        - name: Tempo
          uid: tempo
          type: tempo
          url: http://tempo.monitoring:3200
          jsonData:
              serviceMap:
                  datasourceUid: prometheus # service graph from the otel-gateway (traces_service_graph_*)
              nodeGraph:
                  enabled: true
              tracesToLogsV2:
                  datasourceUid: loki
                  spanStartTimeShift: -5m
                  spanEndTimeShift: 5m
                  filterByTraceID: true
                  customQuery: false
              lokiSearch:
                  datasourceUid: loki
    envValueFrom:
        GF_AUTH_GENERIC_OAUTH_CLIENT_SECRET:
            secretKeyRef:
                name: grafana-oidc # ExternalSecret in monitoring-raw (Vault homelab/oidc: grafana)
                key: client-secret
    persistence:
        enabled: true
        type: pvc
        storageClassName: {{ .Values.storageClass }}
        size: 5Gi
    grafana.ini:
        server:
            root_url: https://grafana.{{ .Values.domain }}
        # Login with Keycloak (realm homelab, client grafana); group admins → Grafana Admin, others Viewer
        auth.generic_oauth:
            enabled: true
            name: Keycloak
            allow_sign_up: true
            client_id: grafana
            scopes: openid profile email groups
            auth_url: https://keycloak.{{ .Values.domain }}/realms/homelab/protocol/openid-connect/auth
            token_url: https://keycloak.{{ .Values.domain }}/realms/homelab/protocol/openid-connect/token
            api_url: https://keycloak.{{ .Values.domain }}/realms/homelab/protocol/openid-connect/userinfo
            signout_redirect_url: https://keycloak.{{ .Values.domain }}/realms/homelab/protocol/openid-connect/logout?post_logout_redirect_uri=https%3A%2F%2Fgrafana.{{ .Values.domain }}%2Flogin
            use_pkce: true
            login_attribute_path: preferred_username
            role_attribute_path: contains(groups[*], 'admins') && 'Admin' || 'Viewer'
            allow_assign_grafana_admin: true
        analytics:
            check_for_updates: false
            reporting_enabled: false
    resources:
        requests:
            cpu: 50m
            memory: 192Mi
        limits:
            memory: 512Mi
kube-state-metrics:
    fullnameOverride: kube-state-metrics
    resources:
        requests:
            cpu: 10m
            memory: 64Mi
        limits:
            memory: 128Mi
prometheus-node-exporter:
    fullnameOverride: node-exporter
    resources:
        requests:
            cpu: 10m
            memory: 32Mi
        limits:
            memory: 64Mi
