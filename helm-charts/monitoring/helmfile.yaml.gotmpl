# Monitoring: kube-prometheus-stack (Prometheus Operator, Prometheus, Alertmanager, Grafana,
# kube-state-metrics, node-exporter). Prometheus selects ServiceMonitors/PodMonitors/PrometheusRules from
# every namespace. prometheus-operator CRDs are installed by bootstrap.sh (outside Argo CD) so every app
# can ship its ServiceMonitor before this app syncs.
# Loki (logs) and Tempo (traces) are single-binary on local-path; Grafana has both as datasources.
repositories:
    - name: prometheus-community
      url: https://prometheus-community.github.io/helm-charts
    # Loki and Tempo charts moved here; the grafana repo stopped at Loki 3.6 / Tempo 2.9
    - name: grafana-community
      url: https://grafana-community.github.io/helm-charts
    - name: bedag
      url: https://bedag.github.io/helm-charts
    - name: grafana
      url: https://grafana.github.io/helm-charts
environments:
    default:
        values:
            - ../environment.yaml
            - kube-prometheus-stack:
                  enabled: true
                  version: 93.3.0
            - loki:
                  enabled: true
                  version: 21.2.3 # Loki 3.7.10
            - tempo:
                  enabled: true
                  version: 3.2.1 # Tempo 3.1.1, single binary
            - monitoring-raw:
                  enabled: true
                  version: 2.0.2
            # Alloy only runs on edge clusters (k8s01 has the OTel collectors of helm-charts/opentelemetry)
            - alloy:
                  enabled: false
                  version: 1.16.0
    # VPS k3s (ADR 0008): an edge cluster. The central pieces stay on k8s01; kube-prometheus-stack runs reduced to
    # kube-state-metrics (values-vps.yaml.gotmpl) and Alloy (next) ships metrics and logs to k8s01 over the tailnet.
    vps:
        values:
            - ../environment-vps.yaml
            - kube-prometheus-stack:
                  enabled: true
                  version: 93.3.0
            - loki:
                  enabled: false
                  version: 21.2.3
            - tempo:
                  enabled: false
                  version: 3.2.1
            - monitoring-raw:
                  enabled: false
                  version: 2.0.2
            - alloy:
                  enabled: true
                  version: 1.16.0
---
templates:
    default: &default
        version: '{{`{{ .Values | get .Release.Name | get "version" }}`}}'
        namespace: monitoring
        values:
            - ./{{`{{ .Release.Name }}`}}/values.yaml.gotmpl
            # values-<environment>.yaml.gotmpl overlays the shared file in every environment but default (k8s01)
            # {{ if ne .Environment.Name "default" }}
            - ./{{`{{ .Release.Name }}`}}/values-{{`{{ .Environment.Name }}`}}.yaml.gotmpl
            # {{ end }}
releases:
    # Grafana admin (ExternalSecret) and HTTPRoutes for Grafana, Prometheus and Alertmanager
    - chart: bedag/raw
      name: monitoring-raw
      condition: monitoring-raw.enabled
      <<: *default
    - chart: prometheus-community/kube-prometheus-stack
      name: kube-prometheus-stack
      condition: kube-prometheus-stack.enabled
      <<: *default
    - chart: grafana-community/loki
      name: loki
      condition: loki.enabled
      <<: *default
    # Edge clusters only: Alloy ships metrics to Prometheus and logs to Loki on k8s01
    - chart: grafana/alloy
      name: alloy
      condition: alloy.enabled
      <<: *default
    # OTLP on tempo:4317 (gRPC) / tempo:4318 (HTTP)
    - chart: grafana-community/tempo
      name: tempo
      condition: tempo.enabled
      <<: *default
