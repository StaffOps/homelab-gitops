// Grafana Alloy on an edge cluster (the VPS k3s, ADR 0008): scraped metrics and logs, each to its backend on k8s01,
// over the tailnet through the k8s01 Gateway:
//   scraped metrics → Prometheus remote-write (https://prometheus.<domain>/api/v1/write)
//   pod and host logs → Loki push (https://loki.<domain>/loki/api/v1/push)
// OTLP from SDKs (Hermes, apps) goes to the otel-agent instead (helm-charts/opentelemetry). Every signal carries
// cluster=<CLUSTER>, the same label k8s01 puts on its own.
// Inserted as-is (readFile, no tpl): settings come from environment variables set in values.yaml.gotmpl.

logging {
    level  = "info"
    format = "logfmt"
}

// ---------- Metrics ----------
// Same series shapes as k8s01 (kube-prometheus-stack), so the kubernetes-mixin dashboards and alerts work with
// cluster="vps": kubelet endpoints under job="kubelet" plus metrics_path, node metrics under job="node-exporter",
// kube-state-metrics with its own labels. Only what this single-node k3s exposes and something on k8s01 reads; every
// cut says why. Not scraped: /metrics/resource (node/pod rollups for metrics-server, the cAdvisor copy covers them)
// and the control plane (k3s runs it inside one process, see kubelet below).

discovery.kubernetes "nodes" {
    role = "node"
}

discovery.kubernetes "endpointslices" {
    role = "endpointslice"
}

discovery.kubernetes "pods" {
    role = "pod"
}

// ----- kubelet: /metrics, /metrics/cadvisor, /metrics/probes, as on k8s01 (job="kubelet", metrics_path=<path>)
discovery.relabel "kubelet" {
    targets = discovery.kubernetes.nodes.targets
    rule {
        source_labels = ["__meta_kubernetes_node_name"]
        target_label  = "node"
    }
    rule {
        target_label = "job"
        replacement  = "kubelet"
    }
    rule {
        target_label = "__metrics_path__"
        replacement  = "/metrics"
    }
    rule {
        target_label = "metrics_path"
        replacement  = "/metrics"
    }
}

discovery.relabel "cadvisor" {
    targets = discovery.relabel.kubelet.output
    rule {
        target_label = "__metrics_path__"
        replacement  = "/metrics/cadvisor"
    }
    rule {
        target_label = "metrics_path"
        replacement  = "/metrics/cadvisor"
    }
}

discovery.relabel "probes" {
    targets = discovery.relabel.kubelet.output
    rule {
        target_label = "__metrics_path__"
        replacement  = "/metrics/probes"
    }
    rule {
        target_label = "metrics_path"
        replacement  = "/metrics/probes"
    }
}

prometheus.scrape "kubelet" {
    job_name          = "kubelet"
    targets           = array.concat(discovery.relabel.kubelet.output, discovery.relabel.cadvisor.output, discovery.relabel.probes.output)
    scheme            = "https"
    bearer_token_file = "/var/run/secrets/kubernetes.io/serviceaccount/token"
    tls_config {
        insecure_skip_verify = true
    }
    forward_to = [prometheus.relabel.kubelet.receiver]
}

prometheus.relabel "kubelet" {
    // /metrics: k3s is one binary, so this endpoint also carries the embedded apiserver, kine, scheduler and
    // controllers (~88k samples). Keep the kubelet's own families (kubelet dashboard and alerts), drop the rest.
    rule {
        source_labels = ["metrics_path", "__name__"]
        regex         = "/metrics;((kubelet|volume_manager|storage_operation|prober|csi_operations|kubernetes_build)_.+|process_(cpu_seconds_total|resident_memory_bytes|start_time_seconds)|go_goroutines|rest_client_requests_total)|/metrics/(cadvisor|probes);.+"
        action        = "keep"
    }
    // kubelet HTTP server latency histogram: no dashboard or alert reads it (_sum/_count stay)
    rule {
        source_labels = ["__name__"]
        regex         = "kubelet_http_requests_duration_seconds_bucket"
        action        = "drop"
    }
    // cAdvisor: only the families the kubernetes-mixin and the k8s01 dashboards read (CPU, throttling, memory,
    // OOM, network, filesystem I/O, machine size); ~50 others (spec, pressure, page faults, blkio, threads) go.
    rule {
        source_labels = ["metrics_path", "__name__"]
        regex         = "/metrics/cadvisor;(container_(cpu_usage_seconds_total|cpu_cfs_(periods|throttled_periods)_total|memory_(working_set_bytes|rss|cache|swap)|oom_events_total|network_(receive|transmit)_(bytes|packets|packets_dropped)_total|fs_(reads|writes)(_bytes)?_total)|machine_(cpu_cores|memory_bytes))|/metrics(/probes)?;.+"
        action        = "keep"
    }
    // Network of the host's own interfaces (pod="", Docker bridges, tailscale): node-exporter has them
    rule {
        source_labels = ["__name__", "pod"]
        regex         = "container_network_.+;"
        action        = "drop"
    }
    // Container series are identified by namespace/pod/container: drop the cgroup path and the runtime id there
    // (kept on pod="" or container="" series, where they are the only difference between cgroups)
    rule {
        source_labels = ["pod", "container", "id"]
        regex         = ".+;.+;.*"
        target_label  = "id"
        replacement   = ""
    }
    rule {
        source_labels = ["pod", "container", "name"]
        regex         = ".+;.+;.*"
        target_label  = "name"
        replacement   = ""
    }
    // /metrics/probes: per-probe latency histogram has no reader (prober_probe_total feeds probe-failure views);
    // pod_uid changes on every recreation and adds nothing over pod
    rule {
        source_labels = ["__name__"]
        regex         = "prober_probe_duration_seconds_bucket"
        action        = "drop"
    }
    rule {
        regex  = "pod_uid"
        action = "labeldrop"
    }
    forward_to = [prometheus.remote_write.central.receiver]
}

// ----- Node (node_exporter built into Alloy, host /proc, /sys and / mounted read-only), job="node-exporter" as on k8s01
prometheus.exporter.unix "node" {
    procfs_path = "/host/proc"
    sysfs_path  = "/host/sys"
    rootfs_path = "/host/root"
    filesystem {
        mount_points_exclude = "^/(dev|proc|run|sys|host|var/lib/kubelet|var/lib/rancher)($|/)"
    }
    // pod veths and the Docker bridges: per-pod network is in cAdvisor, Docker is retired
    netclass {
        ignored_devices = "^(veth.*|br-.*|docker.*)$"
    }
    netdev {
        device_exclude = "^(veth.*|br-.*|docker.*)$"
    }
}

discovery.relabel "node" {
    targets = prometheus.exporter.unix.node.targets
    rule {
        target_label = "job"
        replacement  = "node-exporter"
    }
}

prometheus.scrape "node" {
    targets    = discovery.relabel.node.output
    forward_to = [prometheus.relabel.node.receiver]
}

prometheus.relabel "node" {
    // exporter self-timing per collector: no reader
    rule {
        source_labels = ["__name__"]
        regex         = "node_scrape_collector_.+"
        action        = "drop"
    }
    forward_to = [prometheus.remote_write.central.receiver]
}

// ----- kube-state-metrics: its series carry their own namespace/pod/container labels, so honor them (on k8s01 the
// ServiceMonitor does the same); otherwise they become exported_namespace/exported_pod and the mixin queries break
discovery.relabel "kube_state_metrics" {
    targets = discovery.kubernetes.endpointslices.targets
    rule {
        source_labels = ["__meta_kubernetes_namespace", "__meta_kubernetes_service_name", "__meta_kubernetes_endpointslice_port_name"]
        regex         = "monitoring;kube-state-metrics;http"
        action        = "keep"
    }
    rule {
        target_label = "job"
        replacement  = "kube-state-metrics"
    }
}

prometheus.scrape "kube_state_metrics" {
    targets      = discovery.relabel.kube_state_metrics.output
    honor_labels = true
    forward_to   = [prometheus.relabel.kube_state_metrics.receiver]
}

prometheus.relabel "kube_state_metrics" {
    // object inventories nothing reads (Secrets, ConfigMaps, EndpointSlices, Leases, webhooks, CSRs, IngressClasses)
    rule {
        source_labels = ["__name__"]
        regex         = "kube_(secret|configmap|endpointslice|lease|mutatingwebhookconfiguration|validatingwebhookconfiguration|certificatesigningrequest|ingressclass)_.+"
        action        = "drop"
    }
    // per-object identifiers that change on every recreation and that no query groups by
    rule {
        regex  = "uid|host_ip|pod_ip|host_network"
        action = "labeldrop"
    }
    forward_to = [prometheus.remote_write.central.receiver]
}

// ----- Apps: Services and Pods annotated prometheus.io/scrape=true (+ port, path). The annotated port must be the
// target's container port (one scrape per pod, not one per declared port). Labels as the prometheus-operator puts
// them: namespace, service, pod, container, and job = Service name (or the Pod's app.kubernetes.io/name).
discovery.relabel "annotated_endpoints" {
    targets = discovery.kubernetes.endpointslices.targets
    rule {
        source_labels = ["__meta_kubernetes_service_annotation_prometheus_io_scrape"]
        regex         = "true"
        action        = "keep"
    }
    rule {
        source_labels = ["__meta_kubernetes_service_annotation_prometheus_io_port"]
        target_label  = "__meta_kubernetes_pod_container_port_number"
        action        = "keepequal"
    }
    rule {
        source_labels = ["__meta_kubernetes_service_annotation_prometheus_io_path"]
        regex         = "(.+)"
        target_label  = "__metrics_path__"
    }
    rule {
        source_labels = ["__meta_kubernetes_namespace"]
        target_label  = "namespace"
    }
    rule {
        source_labels = ["__meta_kubernetes_service_name"]
        target_label  = "service"
    }
    rule {
        source_labels = ["__meta_kubernetes_pod_name"]
        target_label  = "pod"
    }
    rule {
        source_labels = ["__meta_kubernetes_pod_container_name"]
        target_label  = "container"
    }
    rule {
        source_labels = ["__meta_kubernetes_service_name"]
        target_label  = "job"
    }
}

discovery.relabel "annotated_pods" {
    targets = discovery.kubernetes.pods.targets
    rule {
        source_labels = ["__meta_kubernetes_pod_annotation_prometheus_io_scrape"]
        regex         = "true"
        action        = "keep"
    }
    rule {
        source_labels = ["__meta_kubernetes_pod_phase"]
        regex         = "Running"
        action        = "keep"
    }
    rule {
        source_labels = ["__meta_kubernetes_pod_container_init"]
        regex         = "true"
        action        = "drop"
    }
    rule {
        source_labels = ["__meta_kubernetes_pod_annotation_prometheus_io_port"]
        target_label  = "__meta_kubernetes_pod_container_port_number"
        action        = "keepequal"
    }
    rule {
        source_labels = ["__meta_kubernetes_pod_annotation_prometheus_io_path"]
        regex         = "(.+)"
        target_label  = "__metrics_path__"
    }
    rule {
        source_labels = ["__meta_kubernetes_namespace"]
        target_label  = "namespace"
    }
    rule {
        source_labels = ["__meta_kubernetes_pod_name"]
        target_label  = "pod"
    }
    rule {
        source_labels = ["__meta_kubernetes_pod_container_name"]
        target_label  = "container"
    }
    rule {
        source_labels = ["__meta_kubernetes_pod_label_app_kubernetes_io_name"]
        target_label  = "job"
    }
}

prometheus.scrape "annotated" {
    job_name   = "annotated"
    targets    = array.concat(discovery.relabel.annotated_endpoints.output, discovery.relabel.annotated_pods.output)
    forward_to = [prometheus.remote_write.central.receiver]
}

prometheus.remote_write "central" {
    external_labels = {
        cluster = sys.env("CLUSTER"),
    }
    endpoint {
        url = sys.env("PROMETHEUS_REMOTE_WRITE_URL")
        queue_config {
            capacity = 10000
        }
    }
}

// ---------- Logs ----------
// Pod logs through the Kubernetes API (no hostPath). Label names as on k8s01, where logs arrive by OTLP:
// k8s_namespace_name, k8s_pod_name, k8s_container_name, service_name
discovery.relabel "pod_logs" {
    targets = discovery.kubernetes.pods.targets
    rule {
        source_labels = ["__meta_kubernetes_namespace"]
        target_label  = "k8s_namespace_name"
    }
    rule {
        source_labels = ["__meta_kubernetes_pod_name"]
        target_label  = "k8s_pod_name"
    }
    rule {
        source_labels = ["__meta_kubernetes_pod_container_name"]
        target_label  = "k8s_container_name"
    }
    rule {
        source_labels = ["__meta_kubernetes_namespace", "__meta_kubernetes_pod_container_name"]
        separator     = "/"
        target_label  = "service_name"
    }
}

loki.source.kubernetes "pods" {
    targets    = discovery.relabel.pod_logs.output
    forward_to = [loki.write.central.receiver]
}

// Host journal: the systemd units that stay on the host (Hermes, center-agent, poller...) and the node itself
loki.relabel "journal" {
    forward_to = []
    rule {
        source_labels = ["__journal__systemd_unit"]
        target_label  = "unit"
    }
    rule {
        source_labels = ["__journal__systemd_unit"]
        regex         = "(.+)\\.service"
        target_label  = "service_name"
    }
}

loki.source.journal "host" {
    path          = "/var/log/journal"
    relabel_rules = loki.relabel.journal.rules
    matches       = sys.env("JOURNAL_MATCHES")
    labels        = {
        job = "systemd-journal",
    }
    forward_to = [loki.write.central.receiver]
}

loki.write "central" {
    external_labels = {
        cluster = sys.env("CLUSTER"),
    }
    endpoint {
        url = sys.env("LOKI_PUSH_URL")
    }
}
