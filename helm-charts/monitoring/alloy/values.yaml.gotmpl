# Grafana Alloy, only on edge clusters (environment vps): scraped metrics to Prometheus and logs to Loki, both on
# k8s01 over the tailnet (config.alloy). OTLP goes to the otel-agent (helm-charts/opentelemetry). The pipeline is
# read as-is from config.alloy; what differs per cluster comes in as env.
alloy:
    configMap:
        create: true
        content: |
            {{- readFile "./config.alloy" | nindent 12 }}
    enableReporting: false
    extraEnv:
        - name: CLUSTER
          value: {{ .Values.cluster.name }}
        - name: PROMETHEUS_REMOTE_WRITE_URL
          value: https://prometheus.{{ .Values.domain }}/api/v1/write
        - name: LOKI_PUSH_URL
          value: https://loki.{{ .Values.domain }}/loki/api/v1/push
        # journald matches (OR between units): the host services and the node itself
        - name: JOURNAL_MATCHES
          value: >-
              _SYSTEMD_UNIT=hermes-gateway.service _SYSTEMD_UNIT=center-agent.service _SYSTEMD_UNIT=openclaw-poller.service
              _SYSTEMD_UNIT=k3s.service _SYSTEMD_UNIT=containerd.service
              _SYSTEMD_UNIT=ssh.service _SYSTEMD_UNIT=cron.service _SYSTEMD_UNIT=tailscaled.service
              _SYSTEMD_UNIT=fail2ban.service _SYSTEMD_UNIT=unattended-upgrades.service
    mounts:
        varlog: false
        dockercontainers: false
        extra:
            - name: journal
              mountPath: /var/log/journal
              readOnly: true
            - name: machine-id
              mountPath: /etc/machine-id
              readOnly: true
            - name: proc
              mountPath: /host/proc
              readOnly: true
            - name: sys
              mountPath: /host/sys
              readOnly: true
            - name: root
              mountPath: /host/root
              readOnly: true
              mountPropagation: HostToContainer
    resources:
        requests:
            cpu: 20m
            memory: 192Mi
        limits:
            memory: 512Mi
controller:
    type: daemonset
    volumes:
        extra:
            - name: journal
              hostPath:
                  path: /var/log/journal
            - name: machine-id
              hostPath:
                  path: /etc/machine-id
                  type: File
            - name: proc
              hostPath:
                  path: /proc
            - name: sys
              hostPath:
                  path: /sys
            - name: root
              hostPath:
                  path: /
service:
    enabled: true
crds:
    create: false
serviceMonitor:
    enabled: false
