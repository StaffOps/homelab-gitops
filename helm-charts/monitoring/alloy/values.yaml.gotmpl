# Grafana Alloy, only on edge clusters (environment vps): metrics to Prometheus, logs to Loki and the host's OTLP to
# the otel-gateway, all on k8s01 over the tailnet (config.alloy). The pipeline is read as-is from config.alloy; what differs per cluster comes in as env.
alloy:
    configMap:
        create: true
        content: |
            {{- readFile "./config.alloy" | nindent 12 }}
    enableReporting: false
    extraEnv:
        - name: CLUSTER
          value: {{ .Values.cluster.name }}
        - name: PROMETHEUS_REMOTE_WRITE_URL
          value: https://prometheus.{{ .Values.domain }}/api/v1/write
        - name: LOKI_PUSH_URL
          value: https://loki.{{ .Values.domain }}/loki/api/v1/push
        - name: OTEL_ENDPOINT
          value: https://otel.{{ .Values.domain }}
        - name: OTEL_EXTERNAL_TOKEN
          valueFrom:
              secretKeyRef:
                  name: otel-external-token
                  key: token
        # journald matches (OR between units): the host services and the node itself
        - name: JOURNAL_MATCHES
          value: >-
              _SYSTEMD_UNIT=hermes-gateway.service _SYSTEMD_UNIT=center-agent.service _SYSTEMD_UNIT=openclaw-poller.service
              _SYSTEMD_UNIT=k3s.service _SYSTEMD_UNIT=containerd.service
              _SYSTEMD_UNIT=ssh.service _SYSTEMD_UNIT=cron.service _SYSTEMD_UNIT=tailscaled.service
              _SYSTEMD_UNIT=fail2ban.service _SYSTEMD_UNIT=unattended-upgrades.service
    extraPorts:
        - name: otlp-http
          port: 4318
          targetPort: 4318
          protocol: TCP
        - name: otlp-grpc
          port: 4317
          targetPort: 4317
          protocol: TCP
    mounts:
        varlog: false
        dockercontainers: false
        extra:
            - name: journal
              mountPath: /var/log/journal
              readOnly: true
            - name: machine-id
              mountPath: /etc/machine-id
              readOnly: true
            - name: proc
              mountPath: /host/proc
              readOnly: true
            - name: sys
              mountPath: /host/sys
              readOnly: true
            - name: root
              mountPath: /host/root
              readOnly: true
              mountPropagation: HostToContainer
    # Beyla (beyla.ebpf) needs root with these capabilities and the host PID namespace (controller.hostPID); not
    # privileged. AppArmor unconfined: the runtime default profile blocks some eBPF attach paths.
    # https://grafana.com/docs/alloy/latest/reference/components/beyla/beyla.ebpf/ (Permissions)
    securityContext:
        runAsUser: 0
        privileged: false
        allowPrivilegeEscalation: true
        appArmorProfile:
            type: Unconfined
        capabilities:
            add: [BPF, NET_ADMIN, NET_RAW, PERFMON, DAC_READ_SEARCH, SYS_PTRACE, CHECKPOINT_RESTORE]
    # Beyla is a child process in the same container: its memory counts here
    resources:
        requests:
            cpu: 30m
            memory: 192Mi
        limits:
            memory: 768Mi
controller:
    type: daemonset
    hostPID: true
    volumes:
        extra:
            - name: journal
              hostPath:
                  path: /var/log/journal
            - name: machine-id
              hostPath:
                  path: /etc/machine-id
                  type: File
            - name: proc
              hostPath:
                  path: /proc
            - name: sys
              hostPath:
                  path: /sys
            - name: root
              hostPath:
                  path: /
# The host reaches the OTLP receiver on a fixed ClusterIP (alloy-raw otlp-service): Hermes exports to it
service:
    enabled: true
crds:
    create: false
serviceMonitor:
    enabled: false
