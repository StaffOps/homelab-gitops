      "gridPos": {
        "x": 12,
        "y": 15,
        "w": 12,
        "h": 8
      },
      "id": 13
    },
    {
      "type": "timeseries",
      "title": "Busy time per second (GPU activity proxy)",
      "description": "Seconds spent generating + seconds spent evaluating prompts, per wall-clock second: rate(llamacpp:tokens_predicted_seconds_total) and rate(llamacpp:prompt_seconds_total) (README: 'total time spent ...'). 1.0 = the server computed the whole time. The time is summed per slot, so parallel requests can push it above 1. This is the best utilization signal for this GPU: nvidia-smi reports no utilization for the GT 740 (see GPU dashboard).",
      "datasource": {
