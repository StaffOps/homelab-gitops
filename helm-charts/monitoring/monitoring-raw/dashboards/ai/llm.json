  "uid": "hl-ai-llm",
  "title": "LLM (llama.cpp)",
  "description": "llama.cpp server (Vulkan backend on the GeForce GT 740) behind https://llm.staffops.space: is it up, is it busy, how fast does it generate, are requests queueing, what does the Gateway see (status codes, latency). Built from the metrics this build really exports (job llama, --metrics) and documented in the llama.cpp server README (https://github.com/ggml-org/llama.cpp/blob/master/tools/server/README.md#get-metrics-prometheus-compatible-metrics-exporter). Replaces the former ConfigMap llm-dashboard (helm-charts/llm). Docs: docs/dashboards/ai.md.",
  "tags": [
    "ai",
    "llm",
    "llama.cpp"
  ],
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 41,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "1m",
  "timezone": "",
  "templating": {
    "list": []
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "name": "Firing alerts (llm)",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "enable": true,
        "iconColor": "red",
        "expr": "ALERTS{alertstate=\"firing\", namespace=\"llm\"}",
        "step": "60s",
        "titleFormat": "{{alertname}}",
        "textFormat": "{{severity}} {{pod}}",
        "useValueForTime": false
      },
      {
        "name": "Container restarts (llm)",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "enable": true,
        "iconColor": "orange",
        "expr": "changes(kube_pod_container_status_restarts_total{namespace=\"llm\"}[2m]) > 0",
        "step": "60s",
        "titleFormat": "Restart {{pod}}",
        "textFormat": "{{container}}",
        "useValueForTime": false
      },
      {
        "name": "llama pod started (model load)",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "enable": true,
        "iconColor": "blue",
        "expr": "(time() - kube_pod_start_time{namespace=\"llm\"}) < 120",
        "step": "60s",
        "titleFormat": "Pod started {{pod}}",
        "textFormat": "New llama pod: model loaded from the models PVC (first start downloads it)",
        "useValueForTime": false
      }
    ]
  },
