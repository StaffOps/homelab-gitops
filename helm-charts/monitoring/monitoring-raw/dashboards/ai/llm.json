    {
      "type": "timeseries",
      "title": "Speed while working",
      "description": "Generation and prompt speed measured only over the time the server was actually computing: rate(tokens)/rate(seconds) for each phase (README counter semantics). Points: the server's own gauges llamacpp:predicted_tokens_seconds / prompt_tokens_seconds, which llama.cpp averages over the window between two scrapes and resets on each scrape (source: https://github.com/ggml-org/llama.cpp/blob/master/tools/server/server-task.cpp, 'the gauges are averaged over the window between two scrapes'); they read 0 when no request finished in that window, so zeros are hidden. A drop of generation speed well below ~7.5 tok/s points to CPU fallback (VRAM full) or GPU throttling.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum(rate(llamacpp:tokens_predicted_total{job=\"llama\"}[$__rate_interval])) / sum(rate(llamacpp:tokens_predicted_seconds_total{job=\"llama\"}[$__rate_interval]))",
          "legendFormat": "generation"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B",
          "expr": "sum(rate(llamacpp:prompt_tokens_total{job=\"llama\"}[$__rate_interval])) / sum(rate(llamacpp:prompt_seconds_total{job=\"llama\"}[$__rate_interval]))",
          "legendFormat": "prompt"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "C",
          "expr": "max(llamacpp:predicted_tokens_seconds{job=\"llama\"}) > 0",
          "legendFormat": "generation (server gauge)"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "D",
          "expr": "max(llamacpp:prompt_tokens_seconds{job=\"llama\"}) > 0",
          "legendFormat": "prompt (server gauge)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: tok/s",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "pointSize": 5,
            "spanNulls": false,
            "lineInterpolation": "linear",
            "thresholdsStyle": {
              "mode": "off"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*server gauge.*"
            },
            "properties": [
              {
