    {
      "type": "timeseries",
      "title": "Requests per second by status code",
      "description": "Requests to llm.staffops.space as seen by the Envoy of Gateway public (Istio standard metric istio_requests_total, reporter=source, destination llama). Formula as in the Istio Service dashboard (https://github.com/istio/istio/tree/master/manifests/addons/dashboards (Istio Service/Workload dashboards)). llama.cpp itself exports no request counter, so this is the only per-request view. 401 = missing/wrong API key; 5xx/503 = pod not ready or crashed. Series appear only after the first request since the gateway pod started (empty = no API traffic).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum by (response_code) (rate(istio_requests_total{reporter=\"source\", source_workload=\"public-istio\", destination_service_name=\"llama\", destination_service_namespace=\"llm\"}[$__rate_interval]))",
          "legendFormat": "{{response_code}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 30,
            "showPoints": "never",
            "pointSize": 5,
            "spanNulls": false,
            "lineInterpolation": "linear",
            "thresholdsStyle": {
              "mode": "off"
            },
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "id": 17
    },
    {
      "type": "timeseries",
      "title": "Request duration (p50 / p95)",
      "description": "histogram_quantile over istio_request_duration_milliseconds_bucket at the Gateway (Istio Service dashboard formula). For an LLM this is the full generation time: ~7.5 tok/s means a 300-token answer takes ~40 s. Streaming responses count until the stream ends. Empty = no API traffic in the window.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(istio_request_duration_milliseconds_bucket{reporter=\"source\", source_workload=\"public-istio\", destination_service_name=\"llama\", destination_service_namespace=\"llm\"}[$__rate_interval])))",
          "legendFormat": "p50"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(istio_request_duration_milliseconds_bucket{reporter=\"source\", source_workload=\"public-istio\", destination_service_name=\"llama\", destination_service_namespace=\"llm\"}[$__rate_interval])))",
          "legendFormat": "p95"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "pointSize": 5,
            "spanNulls": false,
            "lineInterpolation": "linear",
            "thresholdsStyle": {
              "mode": "off"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
