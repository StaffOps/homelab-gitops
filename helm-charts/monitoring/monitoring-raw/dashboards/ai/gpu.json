    {
      "type": "table",
      "title": "Who holds the GPU",
      "description": "Pods with an nvidia.com/gpu request (kube-state-metrics kube_pod_container_resource_requests, resource nvidia_com_gpu), joined with the pod phase. The device plugin gives the whole GPU to one container; nvidia-gpu-exporter reads it without a request.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum by (namespace, pod, container) (kube_pod_container_resource_requests{resource=\"nvidia_com_gpu\"}) * on (namespace, pod) group_left (phase) (max by (namespace, pod, phase) (kube_pod_status_phase == 1))",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "Value": "GPUs",
              "phase": "Phase"
            }
          }
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 6
      },
      "id": 11
    },
