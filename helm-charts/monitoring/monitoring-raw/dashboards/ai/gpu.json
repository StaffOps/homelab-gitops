{
  "id": null,
  "uid": "hl-ai-gpu",
  "title": "GPU (GeForce GT 740)",
  "description": "The lab's only GPU (GeForce GT 740, 4 GiB, Kepler, host driver 470): health of the card (temperature, VRAM, fan, P-state), who holds it in Kubernetes (nvidia.com/gpu requests), and the health of the NVIDIA device plugin and of nvidia-gpu-exporter 1.18.0 (nvidia-smi backend). Curated from the official exporter dashboard https://grafana.com/grafana/dashboards/14574 (utkuozdemir/nvidia_gpu_exporter 'Nvidia GPU Metrics', revision 18): only the panels whose metrics this GPU/driver reports; the official one is not imported because ~40 of its ~50 panels can never have data here (no utilization, power, clocks, throttle reasons, ECC, XID, processes on GT 740 + driver 470). Docs: docs/dashboards/ai.md.",
  "tags": [
    "ai",
    "gpu",
    "nvidia"
  ],
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 41,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "1m",
  "timezone": "",
  "templating": {
    "list": []
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "name": "Firing alerts (GPU)",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "enable": true,
        "iconColor": "red",
        "expr": "ALERTS{alertstate=\"firing\", namespace=\"nvidia-device-plugin\"}",
        "step": "60s",
        "titleFormat": "{{alertname}}",
        "textFormat": "{{severity}}",
        "useValueForTime": false
      },
      {
        "name": "Container restarts (GPU stack + llm)",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "enable": true,
        "iconColor": "orange",
        "expr": "changes(kube_pod_container_status_restarts_total{namespace=~\"nvidia-device-plugin|llm\"}[2m]) > 0",
        "step": "60s",
        "titleFormat": "Restart {{namespace}}/{{pod}}",
        "textFormat": "{{container}}",
        "useValueForTime": false
      },
      {
        "name": "GPU holder changed",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "enable": true,
        "iconColor": "blue",
        "expr": "changes(kube_pod_container_resource_requests{resource=\"nvidia_com_gpu\"}[2m]) > 0 or (time() - kube_pod_start_time{namespace=\"llm\"}) < 120",
        "step": "60s",
        "titleFormat": "GPU pod (re)scheduled",
        "textFormat": "{{namespace}}/{{pod}}",
        "useValueForTime": false
      }
    ]
  },
