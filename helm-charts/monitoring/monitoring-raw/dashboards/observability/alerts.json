      "id": 7,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Number of firing alerts per severity over the selected range. A permanent plateau = a chronic alert (fix the cause or the threshold); spikes that come and go = flapping.",
      "gridPos": {
        "x": 0,
        "y": 25,
        "w": 12,
        "h": 8
