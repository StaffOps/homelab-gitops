{
  "id": null,
  "uid": "hl-observability-alerts",
  "title": "Alerts overview",
  "description": "Every Prometheus alert of the lab (firing and pending), how long it has been active, its history and the chronic ones. Alertmanager routes to a null receiver on purpose: dashboards are where alerts are seen. Data: ALERTS / ALERTS_FOR_STATE (Prometheus alerting rules docs).",
  "tags": [
    "observability",
    "alerts"
  ],
  "timezone": "",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "type": "query",
        "name": "severity",
        "label": "Severity",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(ALERTS{alertname!~\"Watchdog|InfoInhibitor\"}, severity)",
          "refId": "severity-q",
          "qryType": 1
        },
        "definition": "label_values(ALERTS{alertname!~\"Watchdog|InfoInhibitor\"}, severity)",
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2,
        "sort": 1
      },
      {
        "type": "query",
        "name": "namespace",
        "label": "Namespace",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(ALERTS{alertname!~\"Watchdog|InfoInhibitor\"}, namespace)",
          "refId": "namespace-q",
          "qryType": 1
        },
        "definition": "label_values(ALERTS{alertname!~\"Watchdog|InfoInhibitor\"}, namespace)",
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2,
        "sort": 1
      }
    ]
  },
