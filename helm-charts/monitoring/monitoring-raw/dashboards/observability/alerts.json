    {
      "type": "state-timeline",
      "title": "Alert timeline",
      "id": 9,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "One line per alert name: red = firing, orange = pending, empty = inactive. Shows when each alert started and stopped, to correlate with deploys, restarts or Argo CD syncs.",
      "gridPos": {
        "x": 0,
        "y": 33,
