      "title": "Firing alerts by name",
      "id": 11,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "How many series each firing alert has now (one per pod/target/object it fires for). All rules and their evaluation health are in Prometheus → Status → Rules (and the *Prometheus* dashboard: rule evaluation failures).",
      "gridPos": {
        "x": 12,
        "y": 43,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sort_desc(count by (alertname, severity) (ALERTS{alertname!~\"Watchdog|InfoInhibitor\", severity=~\"$severity\", namespace=~\"$namespace\", alertstate=\"firing\"}))",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "Value": "firing series"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "No firing alerts"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "severity"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "mappings",
