          },
          "refId": "A",
          "expr": "max by (alertname) (ALERTS{alertname!~\"Watchdog|InfoInhibitor\", severity=~\"$severity\", namespace=~\"$namespace\", alertstate=\"firing\"}) * 2",
          "legendFormat": "{{alertname}}"
        },
