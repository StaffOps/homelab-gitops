    {
      "type": "bargauge",
      "title": "Most frequent alerts (firing time in range)",
      "id": 10,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Time each alert spent firing over the dashboard range (`count_over_time` of the 1-per-sample ALERTS series × the 30 s rule evaluation interval). The top entries are the chronic ones: worth fixing the cause or tuning the rule.",
      "gridPos": {
        "x": 0,
        "y": 43,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sort_desc(topk(15, sum by (alertname) (count_over_time(ALERTS{alertname!~\"Watchdog|InfoInhibitor\", severity=~\"$severity\", namespace=~\"$namespace\", alertstate=\"firing\"}[$__range])) * 30))",
          "legendFormat": "{{alertname}}",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "fixed",
            "fixedColor": "orange"
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic",
        "showUnfilled": true,
        "valueMode": "color",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
