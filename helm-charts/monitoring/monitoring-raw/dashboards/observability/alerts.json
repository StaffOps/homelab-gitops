          "refId": "A",
          "expr": "count by (severity) (ALERTS{alertname!~\"Watchdog|InfoInhibitor\", severity=~\"$severity\", namespace=~\"$namespace\", alertstate=\"firing\"})",
          "legendFormat": "{{severity}}"
        }
