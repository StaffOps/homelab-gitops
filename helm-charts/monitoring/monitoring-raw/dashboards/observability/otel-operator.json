          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (name) (workqueue_depth{job=\"opentelemetry-operator\", namespace=\"opentelemetry\"})",
          "legendFormat": "depth {{name}}",
          "range": true,
          "instant": false,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (name) (rate(workqueue_adds_total{job=\"opentelemetry-operator\", namespace=\"opentelemetry\"}[$__rate_interval]))",
          "legendFormat": "adds/s {{name}}",
          "range": true,
          "instant": false,
          "refId": "B"
        },
