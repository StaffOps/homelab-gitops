{
  "id": null,
  "uid": "hl-observability-otel-operator",
  "title": "OpenTelemetry Operator & OBI",
  "description": "opentelemetry-operator (reconciles the OpenTelemetryCollector CRs otel-agent/otel-gateway/otel-logs, admission webhooks) and OBI, the eBPF auto-instrumentation DaemonSet. Operator panels use controller-runtime metrics (https://book.kubebuilder.io/reference/metrics-reference) and the chart's managerRules alerts (ReconcileErrors, WorkqueueDepth). OBI exports no scraped self-metrics here, so it is covered by pod resources only. No official dashboard exists for either.",
  "tags": [
    "observability",
    "opentelemetry"
  ],
  "timezone": "",
  "editable": true,
  "graphTooltip": 1,
  "refresh": "1m",
  "schemaVersion": 39,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "enable": true,
        "hide": false,
        "iconColor": "red",
        "name": "Firing alerts",
        "expr": "ALERTS{alertstate=\"firing\", namespace=\"opentelemetry\"} or ALERTS{alertstate=\"firing\", alertname=~\"ReconcileErrors|WorkqueueDepth\"}",
        "step": "60s",
        "titleFormat": "{{alertname}} ({{severity}})",
        "textFormat": "Prometheus ALERTS series in state firing. See Alertmanager / alert rules for details.",
        "tagKeys": "severity",
        "useValueForTime": false
      },
      {
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "enable": true,
        "hide": false,
        "iconColor": "orange",
        "name": "Container restarts",
        "expr": "changes(kube_pod_container_status_restarts_total{namespace=\"opentelemetry\", pod=~\"opentelemetry-operator-.*|obi-.*\"}[2m]) > 0",
        "step": "60s",
        "titleFormat": "Restart: {{pod}} / {{container}}",
        "textFormat": "kube-state-metrics saw the restart counter change (crash, OOMKill or liveness failure).",
        "tagKeys": "container",
        "useValueForTime": false
      },
      {
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "enable": true,
        "hide": false,
        "iconColor": "blue",
        "name": "Collector reconciles",
        "expr": "sum(increase(controller_runtime_reconcile_total{job=\"opentelemetry-operator\", namespace=\"opentelemetry\", controller=\"opentelemetrycollector\", result=\"success\"}[2m])) > 0",
        "step": "60s",
        "titleFormat": "OpenTelemetryCollector reconciled",
        "textFormat": "The operator applied a collector CR (config or image change -> pods rolled).",
        "tagKeys": "",
        "useValueForTime": false
      }
    ]
  },
