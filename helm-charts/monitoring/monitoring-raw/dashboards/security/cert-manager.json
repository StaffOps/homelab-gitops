    {
      "type": "timeseries",
      "title": "ACME requests by action and status",
      "description": "Outbound requests to the ACME servers (certmanager_http_acme_client_request_count) by logical action (new_order, finalize, get_challenge, ...), host (prod or staging) and HTTP status. Mostly flat: requests only happen around issuance/renewal and account checks. 429 = rate limited (mixin alert CertManagerHittingRateLimits), other 4xx/5xx = failed steps. The mixin groups by method/path/status; v1.21 labels the request with action and host instead. Source: cert-manager-mixin (https://github.com/imusmanmalik/cert-manager-mixin, rendered at monitoring-mixins/website assets/cert-manager, commit d4478eb0ca)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (action, host, status) (rate(certmanager_http_acme_client_request_count[$__rate_interval]))",
          "legendFormat": "{{action}} {{status}} ({{host}})",
          "range": true,
          "instant": false,
          "refId": "A"
        }
      ],
      "fieldConfig": {
