      "title": "Soonest certificate expiry",
      "description": "Time until the first certificate expires: min(expiration timestamp) - now. Let's Encrypt certs are renewed 30 days before expiry, so < 30 days (yellow) means a renewal is overdue and < 14 days (red) matches the lab alert CertificateExpiringSoon (the mixin uses ~14.5 days as reference too). Source: cert-manager-mixin (https://github.com/imusmanmalik/cert-manager-mixin, rendered at monitoring-mixins/website assets/cert-manager, commit d4478eb0ca) (Soonest Cert Expiry).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "min(certmanager_certificate_expiration_timestamp_seconds > 0) - time()",
