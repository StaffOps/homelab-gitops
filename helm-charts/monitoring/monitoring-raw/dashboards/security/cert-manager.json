      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (condition) (certmanager_certificate_ready_status)",
          "legendFormat": "{{condition}}",
          "range": false,
          "instant": true,
