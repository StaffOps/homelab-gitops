      },
      {
        "name": "Firing alerts",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "enable": true,
        "hide": false,
        "iconColor": "red",
        "expr": "ALERTS{alertstate=\"firing\", namespace=\"external-secrets\"} or ALERTS{alertstate=\"firing\", alertname=\"VaultSealed\"}",
        "step": "60s",
        "titleFormat": "{{alertname}}",
        "textFormat": "{{severity}}: {{alertname}}",
        "tagKeys": "alertname,severity",
        "useValueForTime": false
      },
      {
        "name": "Container restarts",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "enable": true,
        "hide": false,
        "iconColor": "orange",
        "expr": "changes(kube_pod_container_status_restarts_total{namespace=~\"external-secrets\"}[2m]) > 0",
        "step": "60s",
        "titleFormat": "Restart {{pod}}/{{container}}",
        "textFormat": "container {{container}} of {{pod}} restarted",
        "tagKeys": "namespace,container",
        "useValueForTime": false
      },
      {
        "name": "ExternalSecret not Ready",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "enable": true,
        "hide": false,
        "iconColor": "orange",
        "expr": "externalsecret_status_condition{condition=\"Ready\", status=\"False\"} == 1",
        "step": "60s",
        "titleFormat": "{{exported_namespace}}/{{name}} not Ready",
        "textFormat": "ExternalSecret Ready=False",
        "tagKeys": "name",
        "useValueForTime": false
      },
      {
        "name": "Vault sealed",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "enable": true,
        "hide": false,
        "iconColor": "purple",
        "expr": "vault_core_unsealed{job=\"vault-internal\"} == 0",
        "step": "60s",
        "titleFormat": "Vault SEALED",
        "textFormat": "ESO cannot refresh while Vault is sealed",
        "tagKeys": "",
        "useValueForTime": false
      }
