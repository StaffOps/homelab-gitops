    {
      "type": "table",
      "title": "ExternalSecrets",
      "description": "One row per ExternalSecret: Ready condition, time of the last reconcile (seconds, from externalsecret_reconcile_duration, a gauge in nanoseconds: Go time.Duration) and syncs in the last 24 h (externalsecret_sync_calls_total). With refreshInterval 1h each object syncs ~24 times a day. Source: ESO metrics docs v2.15.0 (https://github.com/external-secrets/external-secrets/blob/v2.15.0/docs/api/metrics.md)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (exported_namespace, name) (externalsecret_status_condition{condition=\"Ready\", status=\"True\"})",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "format": "table",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (exported_namespace, name) (externalsecret_reconcile_duration) / 1e9",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "format": "table",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (exported_namespace, name) (increase(externalsecret_sync_calls_total[24h]))",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "format": "table",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
