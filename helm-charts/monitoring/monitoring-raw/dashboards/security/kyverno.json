    {
      "type": "stat",
      "title": "Controllers up",
      "description": "Scrape status of the four Kyverno controllers (admission = kyverno-svc-metrics, background, cleanup, reports). Admission DOWN: no zone labels and no audit results at admission (Pods are still admitted, failurePolicy Ignore). Source: Prometheus up.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "up{namespace=\"kyverno\", job=~\"kyverno-.*\"}",
          "legendFormat": "{{job}}",
          "range": false,
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "UP",
                  "color": "green",
                  "index": 1
                }
              }
            }
          ],
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
