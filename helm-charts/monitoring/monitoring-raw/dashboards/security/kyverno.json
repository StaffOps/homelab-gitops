    {
      "type": "stat",
      "title": "Admission p99 latency (5m)",
      "description": "99th percentile of the end-to-end admission review time (kyverno_admission_review_duration_seconds). Thresholds from the chart's example alerts: > 1 s warning (KyvernoAdmissionHighLatency), > 5 s critical; Kubernetes times webhooks out at 10 s. Source: kyverno chart 3.10.0 values.yaml prometheusRule example rules",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
