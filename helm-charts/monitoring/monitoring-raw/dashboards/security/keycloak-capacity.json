{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "name": "Firing alerts",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "enable": true,
        "hide": false,
        "iconColor": "red",
        "expr": "ALERTS{alertstate=\"firing\", namespace=\"keycloak\"}",
        "step": "60s",
        "titleFormat": "{{alertname}}",
        "textFormat": "{{severity}}: {{alertname}} {{name}}",
        "tagKeys": "alertname,severity",
        "useValueForTime": false
      },
      {
        "name": "Container restarts",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "enable": true,
        "hide": false,
        "iconColor": "orange",
        "expr": "changes(kube_pod_container_status_restarts_total{namespace=~\"keycloak\"}[2m]) > 0",
        "step": "60s",
        "titleFormat": "Restart {{pod}}/{{container}}",
        "textFormat": "container {{container}} of {{pod}} restarted",
        "tagKeys": "namespace,container",
        "useValueForTime": false
      },
      {
        "name": "Realm import Job running",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "enable": true,
        "hide": false,
        "iconColor": "blue",
        "expr": "kube_job_status_active{namespace=\"keycloak\", job_name=~\"keycloak-realm-import.*\"} > 0",
        "step": "60s",
        "titleFormat": "Realm import (Argo CD PostSync)",
        "textFormat": "keycloak-config-cli applies realm staffops",
        "tagKeys": "job_name",
        "useValueForTime": false
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "links": [
    {
      "type": "dashboards",
      "tags": [
        "security"
      ],
      "asDropdown": true,
      "title": "Security & Identity",
      "includeVars": false,
      "keepTime": true,
      "icon": "external link",
      "targetBlank": false,
      "tooltip": "",
      "url": ""
    }
  ],
  "panels": [
    {
      "type": "text",
      "title": "",
      "description": "How to read this dashboard.",
      "options": {
        "mode": "markdown",
        "content": "### Keycloak capacity planning (official, keycloak-grafana-dashboard@f819507c13)\nLoad handled by Keycloak per event type, to size CPU (password hashing is the expensive part) — see the\n[capacity planning guide](https://www.keycloak.org/high-availability/concepts-memory-and-cpu-sizing). Every panel except\n*Password validations rate* needs **event metrics** (`KC_EVENT_METRICS_USER_ENABLED`, set in `helm-charts/keycloak`):\nempty until synced. The red series of each panel are failed events.",
        "code": {
          "language": "markdown",
          "showLineNumbers": false,
          "showMiniMap": false
        }
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 4
      },
      "id": 1
    },
    {
      "type": "table",
      "title": "Active alerts for this service",
      "id": 9,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Prometheus alerts of this service that are FIRING (condition true for longer than the rule's `for`) or PENDING (condition true, waiting for `for`). Same filter as the red alert annotations of this dashboard; Watchdog/InfoInhibitor are excluded. Empty = healthy. Alertmanager has no receiver in this lab, so dashboards are where alerts are seen: the rule, its threshold and source are in the rule files (helm-charts/<app>/**/prometheus.rules.yaml or the -raw release) and in docs/dashboards/. All alerts of the lab: dashboard \"Alerts overview\" (Observability folder).",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "ALERTS{alertname!~\"Watchdog|InfoInhibitor\", alertstate=~\"firing|pending\", namespace=\"keycloak\"}",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          },
          "noValue": "No active alerts"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "alertstate"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "state"
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "basic"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "firing": {
                        "color": "red",
                        "index": 0
                      },
                      "pending": {
                        "color": "orange",
                        "index": 1
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "severity"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "critical": {
                        "color": "red",
                        "index": 0
                      },
                      "warning": {
                        "color": "orange",
                        "index": 1
                      },
                      "info": {
                        "color": "blue",
                        "index": 2
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true,
              "__name__": true,
              "prometheus": true,
              "endpoint": true,
              "service": true,
              "instance": true,
              "uid": true
            },
            "indexByName": {
              "alertname": 0,
              "alertstate": 1,
              "severity": 2,
              "namespace": 3
            }
          }
        }
      ]
    },
