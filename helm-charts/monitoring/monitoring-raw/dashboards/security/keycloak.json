    {
      "type": "stat",
      "title": "Auth server errors",
      "description": "Share of authentication requests that ended with a server error (outcome=SERVER_ERROR, HTTP 5xx) over the selected range. Example SLO: < 0.1 %. 4xx (bad credentials, invalid grant) are client errors and are not counted. Source: Keycloak SLI guide (https://www.keycloak.org/observability/keycloak-service-level-indicators)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(sum(rate(http_server_requests_seconds_count{job=\"keycloak-http\", uri=~\"/realms/{realm}/protocol/{protocol}.*|/realms/{realm}/login-actions.*\", outcome=\"SERVER_ERROR\"}[$__range])) or vector(0)) / sum(rate(http_server_requests_seconds_count{job=\"keycloak-http\", uri=~\"/realms/{realm}/protocol/{protocol}.*|/realms/{realm}/login-actions.*\"}[$__range]))",
          "legendFormat": "errors",
          "range": false,
          "instant": true,
          "refId": "A"
        }
