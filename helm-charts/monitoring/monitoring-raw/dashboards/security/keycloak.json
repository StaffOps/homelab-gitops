    {
      "type": "timeseries",
      "title": "Failed user events by client (1h)",
      "description": "Failed events per client over the last hour (client_id tag, enabled with event-metrics-user-tags=realm,clientId). Tells which application has a wrong secret or redirect URI. Pending until event metrics are enabled. Labels: Keycloak self-provided metrics (https://www.keycloak.org/observability/metrics-for-troubleshooting-keycloak)",
      "datasource": {
