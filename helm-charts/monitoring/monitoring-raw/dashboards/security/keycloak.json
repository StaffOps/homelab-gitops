    {
      "type": "stat",
      "title": "Auth requests < 250 ms",
      "description": "Share of authentication requests (/realms/{realm}/protocol/* and login-actions) answered within 250 ms over the selected range (bucket le=0.25 / count). Example SLO: 95 %. Needs http-metrics-slos=250 (pending until the Keycloak change is synced). Source: Keycloak SLI guide (https://www.keycloak.org/observability/keycloak-service-level-indicators)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(http_server_requests_seconds_bucket{job=\"keycloak-http\", uri=~\"/realms/{realm}/protocol/{protocol}.*|/realms/{realm}/login-actions.*\", le=\"0.25\"}[$__range])) / sum(rate(http_server_requests_seconds_count{job=\"keycloak-http\", uri=~\"/realms/{realm}/protocol/{protocol}.*|/realms/{realm}/login-actions.*\"}[$__range]))",
          "legendFormat": "< 250 ms",
          "range": false,
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
