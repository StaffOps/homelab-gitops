    {
      "type": "stat",
      "title": "Availability",
      "description": "Share of the selected time range in which at least one Keycloak instance answered the scrape. Example SLO: 99.9 % per month (44 min of downtime). Query from the SLI guide with $__range:$__interval. Source: Keycloak SLI guide (https://www.keycloak.org/observability/keycloak-service-level-indicators)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "count_over_time((sum(up{job=\"keycloak-http\"} > 0))[$__range:$__interval]) / count_over_time(vector(1)[$__range:$__interval])",
          "legendFormat": "availability",
          "range": false,
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "#EAB839",
                "value": 0.99
              },
              {
                "color": "green",
                "value": 0.999
              }
            ]
          },
          "mappings": [],
          "color": {
            "mode": "thresholds"
          },
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false
