          {
            "matcher": {
              "id": "byName",
              "options": "destination_workload_var"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Workload"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "destination_service"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Service"
              },
              {
