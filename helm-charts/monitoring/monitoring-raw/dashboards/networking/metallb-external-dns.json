{
  "id": null,
  "uid": "hl-networking-metallb-external-dns",
  "title": "MetalLB & external-dns",
  "description": "LAN reachability: MetalLB L2 pool usage, IP announcements and ARP; external-dns Cloudflare sync freshness, records and errors. Curated for this lab; see docs/dashboards/networking.md.",
  "tags": [
    "networking",
    "metallb",
    "external-dns",
    "dns"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "1m",
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "name": "Firing alerts",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "enable": true,
        "iconColor": "red",
        "expr": "ALERTS{alertstate=\"firing\", namespace=~\"metallb-system|external-dns\"} or ALERTS{alertstate=\"firing\", alertname=~\"MetalLB.*\"}",
        "step": "60s",
        "titleFormat": "{{alertname}}",
        "textFormat": "{{alertname}} ({{severity}}) {{namespace}} {{pod}}",
        "tagKeys": "severity,alertname",
        "useValueForTime": false
      },
      {
        "name": "Container restarts",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "enable": true,
        "iconColor": "orange",
        "expr": "changes(kube_pod_container_status_restarts_total{namespace=~\"metallb-system|external-dns\"}[2m]) > 0",
        "step": "60s",
        "titleFormat": "Restart",
        "textFormat": "{{namespace}}/{{pod}} container {{container}} restarted",
        "tagKeys": "namespace,pod",
        "useValueForTime": false
      },
      {
        "name": "L2 announcement",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "enable": true,
        "iconColor": "purple",
        "expr": "sum by (ip) (increase(metallb_layer2_gratuitous_sent{job=\"metallb\"}[2m])) > 0",
        "step": "60s",
        "titleFormat": "Gratuitous ARP",
        "textFormat": "speaker (re)announced {{ip}}",
        "tagKeys": "ip",
        "useValueForTime": false
      },
      {
        "name": "DNS records changed",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "enable": true,
        "iconColor": "blue",
        "expr": "changes(external_dns_registry_endpoints_total{job=\"external-dns\"}[2m]) > 0",
        "step": "60s",
        "titleFormat": "DNS change",
        "textFormat": "external-dns changed records in Cloudflare (registry endpoints count moved)",
        "tagKeys": "",
        "useValueForTime": false
      }
    ]
  },
