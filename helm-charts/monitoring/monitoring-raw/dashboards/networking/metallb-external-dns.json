    {
      "type": "gauge",
      "title": "Pool lan usage",
      "description": "Addresses in use / usable addresses of pool lan (metallb_allocator_addresses_in_use_total / _total, https://metallb.io/prometheus-metrics/). Thresholds 75/85/95% = alerts MetalLBAddressPoolUsage75/85/95Percent of the MetalLB chart (https://github.com/metallb/metallb/blob/v0.16.2/charts/metallb/templates/prometheusrules.yaml); 100% = MetalLBAddressPoolExhausted: new LoadBalancer Services stay pending.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (pool) (metallb_allocator_addresses_in_use_total{job=\"metallb-controller-monitor-service\"}) / sum by (pool) (metallb_allocator_addresses_total{job=\"metallb-controller-monitor-service\"})",
          "refId": "A",
          "legendFormat": "{{pool}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
