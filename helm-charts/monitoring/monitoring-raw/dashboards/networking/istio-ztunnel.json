  "title": "Istio Ztunnel (official)",
  "uid": "hl-networking-istio-ztunnel",
  "id": null,
  "description": "Official Istio Ztunnel dashboard, Istio 1.30.8 (https://github.com/istio/istio/tree/1.30.8/manifests/addons/dashboards/ztunnel-dashboard.gen.json, same content as grafana.com 21306). Lab changes: fixed datasource, app=\"ztunnel\" → job=\"istio-system/ztunnel\", guide panel, annotations.",
  "tags": [
    "networking",
    "istio",
    "ztunnel",
    "official"
  ],
  "links": [],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "name": "Firing alerts",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "enable": true,
        "iconColor": "red",
        "expr": "ALERTS{alertstate=\"firing\", namespace=\"istio-system\"}",
        "step": "60s",
        "titleFormat": "{{alertname}}",
        "textFormat": "{{alertname}} ({{severity}}) {{namespace}} {{pod}}",
        "tagKeys": "severity,alertname",
        "useValueForTime": false
      },
      {
        "name": "Container restarts",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "enable": true,
        "iconColor": "orange",
        "expr": "changes(kube_pod_container_status_restarts_total{namespace=~\"istio-system\"}[2m]) > 0",
        "step": "60s",
        "titleFormat": "Restart",
        "textFormat": "{{namespace}}/{{pod}} container {{container}} restarted",
        "tagKeys": "namespace,pod",
        "useValueForTime": false
      }
    ]
  }
}
