{{- $gw := .Values.gateway }}
resources:
    # Grafana admin credentials (Vault homelab/grafana: admin-user, admin-password)
    - apiVersion: external-secrets.io/v1
      kind: ExternalSecret
      metadata:
          name: grafana-admin
      spec:
          refreshInterval: 1h
          secretStoreRef:
              kind: ClusterSecretStore
              name: vault
          target:
              name: grafana-admin
          data:
              - secretKey: admin-user
                remoteRef:
                    key: {{ .Values.vault.prefix }}/grafana
                    property: admin-user
              - secretKey: admin-password
                remoteRef:
                    key: {{ .Values.vault.prefix }}/grafana
                    property: admin-password
    # Client secret of the Keycloak client grafana (Vault homelab/oidc: grafana)
    - apiVersion: external-secrets.io/v1
      kind: ExternalSecret
      metadata:
          name: grafana-oidc
      spec:
          refreshInterval: 1h
          secretStoreRef:
              kind: ClusterSecretStore
              name: vault
          target:
              name: grafana-oidc
          data:
              - secretKey: client-secret
                remoteRef:
                    key: {{ .Values.vault.prefix }}/oidc
                    property: grafana
    {{- range $host, $svc := dict "grafana" (list "grafana" 80) "prometheus" (list "kps-prometheus" 9090) "alertmanager" (list "kps-alertmanager" 9093) }}
    - apiVersion: gateway.networking.k8s.io/v1
      kind: HTTPRoute
      metadata:
          name: {{ $host }}
      spec:
          parentRefs:
              - name: {{ $gw.name }}
                namespace: {{ $gw.namespace }}
                sectionName: https
          hostnames:
              - {{ $host }}.{{ $.Values.domain }}
          rules:
              - backendRefs:
                    - name: {{ index $svc 0 }}
                      port: {{ index $svc 1 }}
    {{- end }}
    # Tempo's MCP server on the shared MCP host (auth at the Gateway, see gateway-raw)
    - apiVersion: gateway.networking.k8s.io/v1
      kind: HTTPRoute
      metadata:
          name: mcp-tempo
      spec:
          parentRefs:
              - name: {{ $gw.name }}
                namespace: {{ $gw.namespace }}
                sectionName: https
          hostnames:
              - mcp.{{ .Values.domain }}
          rules:
              - matches:
                    - path:
                          type: PathPrefix
                          value: /tempo
                filters:
                    - type: URLRewrite
                      urlRewrite:
                          path:
                              type: ReplacePrefixMatch
                              replacePrefixMatch: /api/mcp
                backendRefs:
                    - name: tempo
                      port: 3200

