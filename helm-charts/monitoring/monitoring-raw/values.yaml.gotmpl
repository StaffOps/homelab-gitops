{{- $gw := .Values.gateway }}
resources:
    # Grafana admin credentials (Vault homelab/grafana: admin-user, admin-password)
    - apiVersion: external-secrets.io/v1
      kind: ExternalSecret
      metadata:
          name: grafana-admin
      spec:
          refreshInterval: 1h
          secretStoreRef:
              kind: ClusterSecretStore
              name: vault
          target:
              name: grafana-admin
          data:
              - secretKey: admin-user
                remoteRef:
                    key: {{ .Values.vault.prefix }}/grafana
                    property: admin-user
              - secretKey: admin-password
                remoteRef:
                    key: {{ .Values.vault.prefix }}/grafana
                    property: admin-password
    # Client secret of the Keycloak client grafana (Vault homelab/oidc: grafana)
    - apiVersion: external-secrets.io/v1
      kind: ExternalSecret
      metadata:
          name: grafana-oidc
      spec:
          refreshInterval: 1h
          secretStoreRef:
              kind: ClusterSecretStore
              name: vault
          target:
              name: grafana-oidc
          data:
              - secretKey: client-secret
                remoteRef:
                    key: {{ .Values.vault.prefix }}/oidc
                    property: grafana
    {{- range $host, $svc := dict "grafana" (list "grafana" 80) "prometheus" (list "kps-prometheus" 9090) "alertmanager" (list "kps-alertmanager" 9093) }}
    - apiVersion: gateway.networking.k8s.io/v1
      kind: HTTPRoute
      metadata:
          name: {{ $host }}
      spec:
          parentRefs:
              - name: {{ $gw.name }}
                namespace: {{ $gw.namespace }}
                sectionName: https
          hostnames:
              - {{ $host }}.{{ $.Values.domain }}
          rules:
              - backendRefs:
                    - name: {{ index $svc 0 }}
                      port: {{ index $svc 1 }}
    {{- end }}
    # Tempo's MCP server on the MCP host (Gateway "mcp", JWT auth there, see gateway-raw)
    - apiVersion: gateway.networking.k8s.io/v1
      kind: HTTPRoute
      metadata:
          name: mcp-tempo
      spec:
          parentRefs:
              - name: {{ $gw.mcp.name }}
                namespace: {{ $gw.namespace }}
                sectionName: https
          hostnames:
              - mcp.{{ .Values.domain }}
          rules:
              - matches:
                    - path:
                          type: PathPrefix
                          value: /tempo
                filters:
                    - type: URLRewrite
                      urlRewrite:
                          path:
                              type: ReplacePrefixMatch
                              replacePrefixMatch: /api/mcp
                backendRefs:
                    - name: tempo
                      port: 3200

    # Calico (tigera-operator, installed by homelab-ansible). The metrics are switched on there:
    # FelixConfiguration prometheusMetricsEnabled (9091, no Service from the operator: PodMonitor),
    # Installation typhaMetricsPort 9093 (operator creates Service calico-typha-metrics),
    # kube-controllers 9094 by default (operator Service calico-kube-controllers-metrics),
    # tigera-operator METRICS_ENABLED=true (9484, no Service: PodMonitor). felix and typha are hostNetwork.
    # The calico image registers every Calico metric family in every component (kube-controllers also exports
    # zero-valued felix_*/typha_*), so queries must filter on job.
    - apiVersion: monitoring.coreos.com/v1
      kind: PodMonitor
      metadata:
          name: calico-felix
          namespace: calico-system
      spec:
          selector:
              matchLabels:
                  k8s-app: calico-node
          podMetricsEndpoints:
              # The container declares no ports, so portNumber matches nothing: build the address from the pod IP
              - interval: 30s
                relabelings:
                    - sourceLabels: [__meta_kubernetes_pod_container_name]
                      regex: calico-node
                      action: keep
                    - sourceLabels: [__meta_kubernetes_pod_ip]
                      targetLabel: __address__
                      replacement: $1:9091
                    - targetLabel: job
                      replacement: calico-felix
    - apiVersion: monitoring.coreos.com/v1
      kind: ServiceMonitor
      metadata:
          name: calico-typha
          namespace: calico-system
      spec:
          selector:
              matchLabels:
                  k8s-app: calico-typha-metrics
          endpoints:
              - port: calico-typha-metrics
                interval: 30s
                relabelings:
                    - targetLabel: job
                      replacement: calico-typha
    - apiVersion: monitoring.coreos.com/v1
      kind: ServiceMonitor
      metadata:
          name: calico-kube-controllers
          namespace: calico-system
      spec:
          selector:
              matchLabels:
                  k8s-app: calico-kube-controllers
          endpoints:
              - port: metrics-port
                interval: 30s
                relabelings:
                    - targetLabel: job
                      replacement: calico-kube-controllers
    # calico-kube-controllers is pod-networked and the operator's calico-system tier ends in Deny; its own
    # policy only admits tigera-prometheus on 9094. Admit this Prometheus too (felix/typha are hostNetwork).
    - apiVersion: projectcalico.org/v3
      kind: NetworkPolicy
      metadata:
          name: calico-system.allow-prometheus-kube-controllers
          namespace: calico-system
      spec:
          tier: calico-system
          order: 2
          selector: k8s-app == 'calico-kube-controllers'
          types:
              - Ingress
          ingress:
              - action: Allow
                protocol: TCP
                source:
                    namespaceSelector: kubernetes.io/metadata.name == 'monitoring'
                    selector: app.kubernetes.io/name == 'prometheus'
                destination:
                    ports:
                        - 9094
    - apiVersion: monitoring.coreos.com/v1
      kind: PodMonitor
      metadata:
          name: tigera-operator
          namespace: tigera-operator
      spec:
          selector:
              matchLabels:
                  k8s-app: tigera-operator
          podMetricsEndpoints:
              # The container declares no ports, so portNumber matches nothing: build the address from the pod IP
              - interval: 60s
                relabelings:
                    - sourceLabels: [__meta_kubernetes_pod_container_name]
                      regex: tigera-operator
                      action: keep
                    - sourceLabels: [__meta_kubernetes_pod_ip]
                      targetLabel: __address__
                      replacement: $1:9484
                    - targetLabel: job
                      replacement: tigera-operator
    # Grafana dashboards: one ConfigMap per JSON file under dashboards/<folder>/ (folder titles below). The
    # Grafana sidecar loads every ConfigMap labelled grafana_dashboard and files it under the folder named by the
    # grafana_folder annotation. JSON is inserted as-is (no tpl), so Grafana templates like legend formats stay.
    # Catalog of every dashboard: docs/dashboards/README.md
    {{- $folders := dict "kubernetes" "Kubernetes" "networking" "Networking & Ingress" "security" "Security & Identity" "observability" "Observability" "platform" "GitOps & Platform" "data" "Databases" "ai" "AI & GPU" }}
    {{- range $dir, $title := $folders }}
    {{- range $f := readDir (printf "./dashboards/%s" $dir) }}
    {{- if hasSuffix ".json" $f }}
    - apiVersion: v1
      kind: ConfigMap
      metadata:
          name: dashboard-{{ $dir }}-{{ base $f | trimSuffix ".json" }}
          namespace: monitoring
          labels:
              grafana_dashboard: "1"
          annotations:
              grafana_folder: {{ $title | quote }}
      data:
          {{ base $f }}: {{ readFile $f | toJson }}
    {{- end }}
    {{- end }}
    {{- end }}
    # PrometheusRule: rules inserted as-is (no tpl), so they keep plain Prometheus templates
    - apiVersion: monitoring.coreos.com/v1
      kind: PrometheusRule
      metadata:
          name: calico
          namespace: monitoring
      spec:
          {{- readFile "./calico.rules.yaml" | nindent 10 }}
