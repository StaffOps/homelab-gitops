{{- $pg := .Values.backup.postgres }}
{{- $gw := .Values.gateway }}
resources:
    {{- if .Values.alerting.openclaw.enabled }}
    # Bearer token Alertmanager sends to OpenClaw /hooks/alertmanager (alerting.openclaw in environment.yaml)
    - apiVersion: external-secrets.io/v1
      kind: ExternalSecret
      metadata:
          name: alertmanager-openclaw-hook
      spec:
          refreshInterval: 1h
          secretStoreRef:
              kind: ClusterSecretStore
              name: vault
          target:
              name: alertmanager-openclaw-hook
          data:
              - secretKey: token
                remoteRef:
                    key: {{ .Values.vault.prefix }}/apps/openclaw/openclaw
                    property: OPENCLAW_HOOKS_TOKEN
    {{- end }}
    # Grafana admin credentials (Vault homelab/grafana: admin-user, admin-password)
    - apiVersion: external-secrets.io/v1
      kind: ExternalSecret
      metadata:
          name: grafana-admin
      spec:
          refreshInterval: 1h
          secretStoreRef:
              kind: ClusterSecretStore
              name: vault
          target:
              name: grafana-admin
          data:
              - secretKey: admin-user
                remoteRef:
                    key: {{ .Values.vault.prefix }}/grafana
                    property: admin-user
              - secretKey: admin-password
                remoteRef:
                    key: {{ .Values.vault.prefix }}/grafana
                    property: admin-password
    # Client secret of the Keycloak client grafana (Vault homelab/oidc: grafana)
    - apiVersion: external-secrets.io/v1
      kind: ExternalSecret
      metadata:
          name: grafana-oidc
      spec:
          refreshInterval: 1h
          secretStoreRef:
              kind: ClusterSecretStore
              name: vault
          target:
              name: grafana-oidc
          data:
              - secretKey: client-secret
                remoteRef:
                    key: {{ .Values.vault.prefix }}/oidc
                    property: grafana
    # PostgreSQL for Grafana (CloudNativePG) instead of SQLite on a local volume: users, preferences and service-account
    # tokens (MCP server) come back with the database restore. Secret grafana-db-app (username, password).
    - apiVersion: postgresql.cnpg.io/v1
      kind: Cluster
      metadata:
          name: grafana-db
      spec:
          instances: 1
          storage:
              storageClass: {{ .Values.storageClass }}
              size: 5Gi
          bootstrap:
              {{- if ($pg | get "restore" false) }}
              # Disaster recovery (backup.postgres.restore in environment.yaml): rebuild from the R2 backups
              recovery:
                  source: origin
                  {{- with ($pg | get "restoreTargetTime" "") }}
                  recoveryTarget:
                      targetTime: {{ . | quote }}
                  {{- end }}
              {{- else }}
              initdb:
                  database: grafana
                  owner: grafana
              {{- end }}
          {{- if ($pg | get "restore" false) }}
          externalClusters:
              - name: origin
                plugin:
                    name: barman-cloud.cloudnative-pg.io
                    parameters:
                        barmanObjectName: grafana-db-r2
                        serverName: grafana-db{{ ($pg | get "restoreFromSuffix" "") }}
          {{- end }}
          # metrics: one PodMonitor for every cluster (cloudnative-pg-raw); the per-cluster one is deprecated
          monitoring:
              enablePodMonitor: false
          # Base backups + WAL to R2 through the Barman Cloud plugin (ObjectStore grafana-db-r2 below)
          plugins:
              - name: barman-cloud.cloudnative-pg.io
                isWALArchiver: true
                parameters:
                    barmanObjectName: grafana-db-r2
                    {{- with ($pg | get "serverSuffix" "") }}
                    serverName: grafana-db{{ . }}
                    {{- end }}
          resources:
              requests:
                  cpu: 50m
                  memory: 256Mi
              limits:
                  memory: 1Gi
    # Object store for grafana-db (Barman Cloud plugin): s3://<bucket>/<prefix>/grafana-db/. Credentials: the Velero R2
    # token (Vault homelab/velero); endpoint: R2_ENDPOINT from the Argo CD render env, never in git.
    - apiVersion: external-secrets.io/v1
      kind: ExternalSecret
      metadata:
          name: grafana-db-r2
      spec:
          refreshInterval: 1h
          secretStoreRef:
              kind: ClusterSecretStore
              name: vault
          target:
              name: grafana-db-r2
          data:
              - secretKey: ACCESS_KEY_ID
                remoteRef:
                    key: {{ .Values.vault.prefix }}/velero
                    property: access-key-id
              - secretKey: ACCESS_SECRET_KEY
                remoteRef:
                    key: {{ .Values.vault.prefix }}/velero
                    property: secret-access-key
    - apiVersion: barmancloud.cnpg.io/v1
      kind: ObjectStore
      metadata:
          name: grafana-db-r2
      spec:
          retentionPolicy: {{ .Values.backup.postgres.retention | quote }}
          configuration:
              destinationPath: s3://{{ .Values.backup.bucket }}/{{ .Values.backup.postgres.prefix }}/
              {{- with env "R2_ENDPOINT" }}
              endpointURL: {{ . }}
              {{- end }}
              s3Credentials:
                  accessKeyId:
                      name: grafana-db-r2
                      key: ACCESS_KEY_ID
                  secretAccessKey:
                      name: grafana-db-r2
                      key: ACCESS_SECRET_KEY
              wal:
                  compression: gzip
              data:
                  compression: gzip
          instanceSidecarConfiguration:
              # R2 rejects the boto3 default checksum headers (plugin docs, "Object Store Providers")
              env:
                  - name: AWS_REQUEST_CHECKSUM_CALCULATION
                    value: when_required
                  - name: AWS_RESPONSE_CHECKSUM_VALIDATION
                    value: when_required
              resources:
                  requests:
                      cpu: 10m
                      memory: 64Mi
                  limits:
                      memory: 256Mi
    - apiVersion: postgresql.cnpg.io/v1
      kind: ScheduledBackup
      metadata:
          name: grafana-db-daily
      spec:
          schedule: {{ .Values.backup.postgres.schedule | quote }}
          backupOwnerReference: self
          immediate: true
          cluster:
              name: grafana-db
          method: plugin
          pluginConfiguration:
              name: barman-cloud.cloudnative-pg.io
    {{- /* loki: push endpoint for edge clusters (Alloy on the VPS, over the tailnet) */}}
    {{- range $host, $svc := dict "grafana" (list "grafana" 80) "prometheus" (list "kps-prometheus" 9090) "alertmanager" (list "kps-alertmanager" 9093) "loki" (list "loki" 3100) }}
    - apiVersion: gateway.networking.k8s.io/v1
      kind: HTTPRoute
      metadata:
          name: {{ $host }}
      spec:
          parentRefs:
              - name: {{ $gw.name }}
                namespace: {{ $gw.namespace }}
                sectionName: https
          hostnames:
              - {{ $host }}.{{ $.Values.domain }}
          rules:
              - backendRefs:
                    - name: {{ index $svc 0 }}
                      port: {{ index $svc 1 }}
    {{- end }}
    # Tempo's MCP server on the MCP host (Gateway "mcp", JWT auth there, see gateway-raw)
    - apiVersion: gateway.networking.k8s.io/v1
      kind: HTTPRoute
      metadata:
          name: mcp-tempo
      spec:
          parentRefs:
              - name: {{ $gw.mcp.name }}
                namespace: {{ $gw.namespace }}
                sectionName: https
          hostnames:
              - mcp.{{ .Values.domain }}
          rules:
              - matches:
                    - path:
                          type: PathPrefix
                          value: /tempo
                filters:
                    - type: URLRewrite
                      urlRewrite:
                          path:
                              type: ReplacePrefixMatch
                              replacePrefixMatch: /api/mcp
                backendRefs:
                    - name: tempo
                      port: 3200

    # Calico (tigera-operator, installed by homelab-ansible). The metrics are switched on there:
    # FelixConfiguration prometheusMetricsEnabled (9091, no Service from the operator: PodMonitor),
    # Installation typhaMetricsPort 9093 (operator creates Service calico-typha-metrics),
    # kube-controllers 9094 by default (operator Service calico-kube-controllers-metrics),
    # tigera-operator METRICS_ENABLED=true (9484, no Service: PodMonitor). felix and typha are hostNetwork.
    # The calico image registers every Calico metric family in every component (kube-controllers also exports
    # zero-valued felix_*/typha_*), so queries must filter on job.
    - apiVersion: monitoring.coreos.com/v1
      kind: PodMonitor
      metadata:
          name: calico-felix
          namespace: calico-system
      spec:
          selector:
              matchLabels:
                  k8s-app: calico-node
          podMetricsEndpoints:
              # The container declares no ports, so portNumber matches nothing: build the address from the pod IP
              - interval: 30s
                relabelings:
                    - sourceLabels: [__meta_kubernetes_pod_container_name]
                      regex: calico-node
                      action: keep
                    - sourceLabels: [__meta_kubernetes_pod_ip]
                      targetLabel: __address__
                      replacement: $1:9091
                    - targetLabel: job
                      replacement: calico-felix
    - apiVersion: monitoring.coreos.com/v1
      kind: ServiceMonitor
      metadata:
          name: calico-typha
          namespace: calico-system
      spec:
          selector:
              matchLabels:
                  k8s-app: calico-typha-metrics
          endpoints:
              - port: calico-typha-metrics
                interval: 30s
                relabelings:
                    - targetLabel: job
                      replacement: calico-typha
    - apiVersion: monitoring.coreos.com/v1
      kind: ServiceMonitor
      metadata:
          name: calico-kube-controllers
          namespace: calico-system
      spec:
          selector:
              matchLabels:
                  k8s-app: calico-kube-controllers
          endpoints:
              - port: metrics-port
                interval: 30s
                relabelings:
                    - targetLabel: job
                      replacement: calico-kube-controllers
    # calico-kube-controllers is pod-networked and the operator's calico-system tier ends in Deny; its own
    # policy only admits tigera-prometheus on 9094. Admit this Prometheus too (felix/typha are hostNetwork).
    - apiVersion: projectcalico.org/v3
      kind: NetworkPolicy
      metadata:
          name: calico-system.allow-prometheus-kube-controllers
          namespace: calico-system
      spec:
          tier: calico-system
          order: 2
          selector: k8s-app == 'calico-kube-controllers'
          types:
              - Ingress
          ingress:
              - action: Allow
                protocol: TCP
                source:
                    namespaceSelector: kubernetes.io/metadata.name == 'monitoring'
                    selector: app.kubernetes.io/name == 'prometheus'
                destination:
                    ports:
                        - 9094
    - apiVersion: monitoring.coreos.com/v1
      kind: PodMonitor
      metadata:
          name: tigera-operator
          namespace: tigera-operator
      spec:
          selector:
              matchLabels:
                  k8s-app: tigera-operator
          podMetricsEndpoints:
              # The container declares no ports, so portNumber matches nothing: build the address from the pod IP
              - interval: 60s
                relabelings:
                    - sourceLabels: [__meta_kubernetes_pod_container_name]
                      regex: tigera-operator
                      action: keep
                    - sourceLabels: [__meta_kubernetes_pod_ip]
                      targetLabel: __address__
                      replacement: $1:9484
                    - targetLabel: job
                      replacement: tigera-operator
    # Grafana dashboards: one ConfigMap per JSON file under dashboards/<folder>/ (folder titles below). The
    # Grafana sidecar loads every ConfigMap labelled grafana_dashboard and files it under the folder named by the
    # grafana_folder annotation. JSON is inserted as-is (no tpl), so Grafana templates like legend formats stay.
    # Catalog of every dashboard: docs/dashboards/README.md
    {{- $folders := dict "kubernetes" "Kubernetes" "networking" "Networking & Ingress" "security" "Security & Identity" "observability" "Observability" "platform" "GitOps & Platform" "data" "Databases" "ai" "AI & GPU" }}
    {{- range $dir, $title := $folders }}
    {{- range $f := readDir (printf "./dashboards/%s" $dir) }}
    {{- if hasSuffix ".json" $f }}
    - apiVersion: v1
      kind: ConfigMap
      metadata:
          name: dashboard-{{ $dir }}-{{ base $f | trimSuffix ".json" }}
          namespace: monitoring
          labels:
              grafana_dashboard: "1"
          annotations:
              grafana_folder: {{ $title | quote }}
      data:
          {{ base $f }}: {{ readFile $f | toJson }}
    {{- end }}
    {{- end }}
    {{- end }}
    # PrometheusRule: rules inserted as-is (no tpl), so they keep plain Prometheus templates
    - apiVersion: monitoring.coreos.com/v1
      kind: PrometheusRule
      metadata:
          name: calico
          namespace: monitoring
      spec:
          {{- readFile "./calico.rules.yaml" | nindent 10 }}
    - apiVersion: monitoring.coreos.com/v1
      kind: PrometheusRule
      metadata:
          name: tempo
          namespace: monitoring
      spec:
          {{- readFile "./tempo.rules.yaml" | nindent 10 }}
    - apiVersion: monitoring.coreos.com/v1
      kind: PrometheusRule
      metadata:
          name: grafana
          namespace: monitoring
      spec:
          {{- readFile "./grafana.rules.yaml" | nindent 10 }}
