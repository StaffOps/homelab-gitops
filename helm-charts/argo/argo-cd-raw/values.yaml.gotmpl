# Argo CD objects applied after the argo-cd release (they need its CRDs): AppProject platform, root
# Application argo-cd and ApplicationSet platform. One file per object in resources/, rendered with the
# helmfile values (tpl). bedag/raw does not run tpl again, so Argo CD expressions are escaped once.
resources:
    {{- range $f := readDir "./resources" }}
    {{- tpl (readFile (printf "./%s" $f)) $ | nindent 4 }}
    {{- end }}
