{{- /*
Argo CD for the homelab (kubeadm single node). No secrets are needed to render this release: the git
repository is public and Redis is the chart's internal one. TLS terminates at the shared Gateway.
*/ -}}
fullnameOverride: argo-cd
global:
    domain: &fqdn 'argocd.{{ .Values.domain }}'
    logging:
        format: json
        level: info
crds:
    install: true
    keep: true
configs:
    cm:
        admin.enabled: true # local admin kept as break-glass (Keycloak down)
        accounts.mcp: apiKey # token for the Argo CD MCP server (Vault homelab/mcp: argocd-token)
        accounts.backstage: apiKey # token for the Backstage Argo CD plugin (Vault homelab/backstage: argocd-token)
        # token for Argo Workflows (ClusterWorkflowTemplate argocd-sync; Vault homelab/argo-workflows: argocd-token)
        accounts.argo-workflows: apiKey
        # Links from Argo Workflows objects to their page in the Argo Workflows UI
        resource.links: |
            - title: Argo Workflows
              url: https://argo-workflows.{{ .Values.domain }}/workflows/{{`{{ .resource.metadata.namespace }}/{{ .resource.metadata.name }}`}}
              if: resource.kind == "Workflow"
            - title: Argo Workflows
              url: https://argo-workflows.{{ .Values.domain }}/cron-workflows/{{`{{ .resource.metadata.namespace }}/{{ .resource.metadata.name }}`}}
              if: resource.kind == "CronWorkflow"
            - title: Argo Workflows
              url: https://argo-workflows.{{ .Values.domain }}/workflow-templates/{{`{{ .resource.metadata.namespace }}/{{ .resource.metadata.name }}`}}
              if: resource.kind == "WorkflowTemplate"
        # Login with Keycloak (realm keycloak.realm, client argocd); the secret comes from Secret argocd-oidc
        # (ExternalSecret in argo-cd-raw, label part-of=argocd so Argo CD can reference it)
        oidc.config: |
            name: Keycloak
            issuer: https://keycloak.{{ .Values.domain }}/realms/{{ .Values.keycloak.realm }}
            clientID: argocd
            clientSecret: $argocd-oidc:clientSecret
            enablePKCEAuthentication: true # the Keycloak client requires PKCE (S256)
            requestedScopes:
                - openid
                - profile
                - email
                - groups
        # Poll git every 15-25s (no webhook: GitHub cannot reach the LAN). Rendering is cached per commit, so
        # polling only costs a git ls-remote per repo.
        timeout.reconciliation: 15s
        timeout.reconciliation.jitter: 10s
        resource.customizations.ignoreDifferences.all: |
            jsonPointers:
                - /status
        resource.customizations.ignoreDifferences.gateway.networking.k8s.io_HTTPRoute: |
            jqPathExpressions:
                - .spec.parentRefs[]?.group
                - .spec.parentRefs[]?.kind
                - .spec.rules[]?.backendRefs[]?.group
                - .spec.rules[]?.backendRefs[]?.kind
                - .spec.rules[]?.backendRefs[]?.weight
        resource.customizations.ignoreDifferences.external-secrets.io_ExternalSecret: |
            jqPathExpressions:
                - .spec.data[]?.remoteRef.conversionStrategy
                - .spec.data[]?.remoteRef.decodingStrategy
                - .spec.data[]?.remoteRef.metadataPolicy
        resource.exclusions: |
            - apiGroups:
                  - cilium.io
                  - kyverno.io
                  - wgpolicyk8s.io
              kinds:
                  - CiliumIdentity
                  - AdmissionReport
                  - BackgroundScanReport
                  - ClusterAdmissionReport
                  - ClusterBackgroundScanReport
                  - PolicyReport
              clusters:
                  - '*'
            - apiGroups:
                  - certificates.k8s.io
              kinds:
                  - CertificateSigningRequest
              clusters:
                  - '*'
    # Keycloak groups /argocd/admin → role:admin, /argocd/viewer → role:readonly; anyone else gets nothing
    rbac:
        policy.default: ""
        scopes: "[groups]"
        policy.csv: |
            g, /argocd/admin, role:admin
            g, /argocd/viewer, role:readonly
            g, mcp, role:readonly
            g, backstage, role:readonly
            p, role:workflows, applications, get, */*, allow
            p, role:workflows, applications, sync, */*, allow
            g, argo-workflows, role:workflows
    params:
        create: true
        server.insecure: true # TLS terminates at the Gateway
        # argocd_app_condition{condition=...} per app (dashboard "Argo CD / Operations"); off by default upstream
        controller.metrics.application.conditions: ComparisonError,SyncError,InvalidSpecError
    cmp:
        create: true
        plugins:
            # https://github.com/travisghansen/argo-cd-helmfile
            helmfile:
                init:
                    command: [argo-cd-helmfile.sh]
                    args: [init]
                generate:
                    command: [argo-cd-helmfile.sh]
                    args: [generate]
                discover:
                    find:
                        command: [argo-cd-helmfile.sh, discover]
                parameters:
                    dynamic:
                        command: [argo-cd-helmfile.sh, parameters]
                preserveFileMode: true
redis:
    enabled: true
    metrics:
        enabled: false
    resources:
        requests:
            cpu: 50m
            memory: 64Mi
        limits:
            memory: 128Mi
controller:
    replicas: 1
    resources:
        requests:
            cpu: 400m
            memory: 1536Mi
        limits:
            memory: 3Gi # OOMKilled at 1Gi with ~20 apps
    metrics:
        enabled: true
        serviceMonitor:
            enabled: true
        rules:
            enabled: true
            spec:
                - alert: ArgoAppNotSynced
                  expr: argocd_app_info{sync_status!="Synced"} == 1
                  for: 15m
                  labels:
                      severity: warning
                  annotations:
                      summary: 'Application {{`{{ $labels.name }}`}} out of sync for 15m'
                - alert: ArgoAppUnhealthy
                  expr: argocd_app_info{health_status!~"Healthy|Progressing"} == 1
                  for: 15m
                  labels:
                      severity: warning
                  annotations:
                      summary: 'Application {{`{{ $labels.name }}`}} is {{`{{ $labels.health_status }}`}}'
                # Derived (docs/dashboards/platform.md): repo-server manifest render errors (go-grpc-prometheus
                # grpc_server_handled_total, non-OK GenerateManifest) surface before ArgoAppNotSynced (15m).
                - alert: ArgoRepoServerRenderErrors
                  expr: sum by (namespace, job) (increase(grpc_server_handled_total{job="argo-cd-repo-server-metrics", grpc_method="GenerateManifest", grpc_code!="OK"}[15m])) > 0
                  labels:
                      severity: warning
                  annotations:
                      summary: 'Argo CD repo-server failed to render manifests {{`{{ $value | humanize }}`}} times in 15m. Check the app conditions and scripts/render-app.sh'
dex:
    enabled: false
# Notifications → Argo Events (EventSource argocd in argo-events): every app reports sync succeeded/failed and
# health degraded, so Sensors can start Argo Workflows after a deploy. Triggers follow the upstream catalog.
notifications:
    enabled: true
    argocdUrl: https://argocd.{{ .Values.domain }}
    metrics:
        enabled: true
        serviceMonitor:
            enabled: true
    notifiers:
        service.webhook.argo-events: |
            url: http://argocd-eventsource-svc.argo-events.svc:12000/argocd
            headers:
                - name: Content-Type
                  value: application/json
    templates:
        template.app-event: |
            webhook:
                argo-events:
                    method: POST
                    body: |
                        {"app": "{{`{{ .app.metadata.name }}`}}", "project": "{{`{{ .app.spec.project }}`}}", "revision": "{{`{{ .app.status.sync.revision }}`}}", "sync": "{{`{{ .app.status.sync.status }}`}}", "health": "{{`{{ .app.status.health.status }}`}}", "phase": "{{`{{ if .app.status.operationState }}{{ .app.status.operationState.phase }}{{ end }}`}}"}
    triggers:
        trigger.on-sync-succeeded: |
            - when: app.status.operationState != nil and app.status.operationState.phase in ['Succeeded']
              send: [app-event]
        trigger.on-sync-failed: |
            - when: app.status.operationState != nil and app.status.operationState.phase in ['Error', 'Failed']
              send: [app-event]
        trigger.on-health-degraded: |
            - when: app.status.health.status == 'Degraded'
              send: [app-event]
    subscriptions:
        - recipients:
              - argo-events
          triggers:
              - on-sync-succeeded
              - on-sync-failed
              - on-health-degraded
    resources:
        requests:
            cpu: 10m
            memory: 32Mi
        limits:
            memory: 128Mi
commitServer:
    enabled: false
server:
    replicas: 1
    metrics:
        enabled: true
        serviceMonitor:
            enabled: true
    httproute:
        enabled: true
        parentRefs:
            - name: {{ .Values.gateway.name }}
              namespace: {{ .Values.gateway.namespace }}
              sectionName: https
        hostnames:
            - *fqdn
    # UI extension: Rollout tab (canary/blue-green steps, promote/abort) on Argo Rollouts resources
    extensions:
        enabled: true
        extensionList:
            - name: rollout-extension
              env:
                  - name: EXTENSION_URL
                    value: https://github.com/argoproj-labs/rollout-extension/releases/download/v0.4.1/extension.tar
                  - name: EXTENSION_VERSION
                    value: v0.4.1
    resources:
        requests:
            cpu: 50m
            memory: 128Mi
        limits:
            memory: 256Mi
repoServer:
    replicas: 1
    # Resolved branch→commit is cached 1m by default, which would hide the 15s polling (configs.cm)
    extraArgs:
        - --revision-cache-expiration=15s
    # gRPC latency histograms (grpc_server_handling_seconds): GenerateManifest = helmfile plugin render time
    env:
        - name: ARGOCD_ENABLE_GRPC_TIME_HISTOGRAM
          value: "true"
    metrics:
        enabled: true
        serviceMonitor:
            enabled: true
    resources:
        requests:
            cpu: 100m
            memory: 256Mi
        limits:
            memory: 512Mi
    volumes:
        - name: helmfile-cmp-tmp
          emptyDir: {}
    extraContainers:
        # The plugin image ships helmfile, helm and the plugin script: no init container needed.
        - name: helmfile-plugin
          image: docker.io/travisghansen/argo-cd-helmfile:v0.3.13@sha256:1251e329f72cadaf55860b9029d13c887559b5f20287915f21d32d722aaeef2e
          command: [/var/run/argocd/argocd-cmp-server]
          env:
              - name: HELMFILE_CACHE_CLEANUP
                value: "true"
              # helmfile skips the charts' crds/ directory unless asked
              - name: HELMFILE_TEMPLATE_OPTIONS
                value: --include-crds
          # Values that must reach a manifest but not git (e.g. the R2 endpoint, which holds the Cloudflare
          # account id): Secret argocd-render-env (ExternalSecret in argo-cd-raw), read as {{ env "NAME" }}.
          # Changing one needs a hard refresh of the app: manifests are cached per commit.
          envFrom:
              - secretRef:
                    name: argocd-render-env
                    optional: true
          securityContext:
              runAsNonRoot: true
              runAsUser: 999
              allowPrivilegeEscalation: false
              capabilities:
                  drop: [ALL]
              seccompProfile:
                  type: RuntimeDefault
          resources:
              requests:
                  cpu: 100m
                  memory: 256Mi
              limits:
                  memory: 1Gi
          volumeMounts:
              - mountPath: /var/run/argocd
                name: var-files
              - mountPath: /home/argocd/cmp-server/plugins
                name: plugins
              - mountPath: /tmp
                name: helmfile-cmp-tmp
applicationSet:
    replicas: 1
    metrics:
        enabled: true
        serviceMonitor:
            enabled: true
    resources:
        requests:
            cpu: 50m
            memory: 128Mi
        limits:
            memory: 256Mi
